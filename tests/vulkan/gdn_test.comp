#version 460
// The unit tests' own GDN kernels: those of tests/metal/gdn_test.metal, and
// the serial conv oracle whose Metal source is in tests/unit/kernels/gdn.rs
// (`CONV1D_SERIAL_REF`).
#include "common.glsl"
#ifdef KERNEL_gdn_step
#define GDN_STEP_BODY
#endif
#include "gdn_common.glsl"

// The unfused recurrent-step oracle: gdn.comp's step body, its output stored
// as it is.
#ifdef KERNEL_gdn_step
void main() {
    float scale = arg_f32(9);
    uint vpk = arg_u32(10);
    uint h = threadgroup_position_in_grid.x, tid = thread_index_in_threadgroup;
    float o = gdn_step_body(BF16(arg(0)), BF16(arg(1)), BF16(arg(2)), BF16(arg(3)), BF16(arg(4)),
                            F32(arg(5)), BF16(arg(6)), arg(7), scale, vpk, h, tid,
                            simdgroup_index_in_threadgroup, thread_index_in_simdgroup);
    BF16(arg(8)).v[h * DIM + tid] = bfloat16_t(o);
}
#endif

// Streaming reference for the decode step's state traffic
// (`gdn_state_stream_timing`): thread (rg, c) of a threadgroup of C * RG
// reads its DIM / RG rows of column c in blocks of eight loads, scales them
// and writes them back.
#ifdef KERNEL_gdn_state_stream
void main() {
    uint C = arg_u32(2), RG = arg_u32(3);
    float decay = arg_f32(4);
    uint tg = threadgroup_position_in_grid.x, tid = thread_index_in_threadgroup;
    uint groups_per_head = DIM / C;
    uint h = tg / groups_per_head;
    uint cg = tg % groups_per_head;
    uint col = cg * C + tid % C;
    uint rg = tid / C;
    uint rows = DIM / RG;
    F32 st = F32(arg(0) + 4 * (uint64_t(h) * (DIM * DIM) + uint64_t(rg * rows) * DIM + col));
    float acc = 0.0;
    for (uint r0 = 0; r0 < rows; r0 += 8) {
        float sv[8];
        for (uint j = 0; j < 8; ++j) sv[j] = st.v[(r0 + j) * DIM];
        for (uint j = 0; j < 8; ++j) {
            float u = sv[j] * decay;
            st.v[(r0 + j) * DIM] = u;
            acc += u;
        }
    }
    if (acc == 12345.678) F32(arg(1)).v[col] = acc;
}
#endif

// Serial prefill conv oracle: gdn.comp's tiled conv1d_prefill_bf16 must match
// its output and carried window bit for bit, so the row arithmetic is
// written as it is there.
#ifdef KERNEL_conv1d_prefill_serial_ref
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    BF16 window = BF16(arg(0)), w = BF16(arg(2));
    uint64_t x = arg(1), dst = arg(3);
    uint C = arg_u32(4), KD = arg_u32(5), M = arg_u32(6);
    uint c = thread_position_in_grid.x;
    uint taps = KD - 1;
    float win[8], wt[8];
    for (uint t = 0; t < 8; ++t) {
        win[t] = 0.0;
        wt[t] = 0.0;
        if (t < taps) {
            win[t] = float(window.v[c * taps + t]);
            wt[t] = float(w.v[t * C + c]);
        }
    }
    float w_x = float(w.v[taps * C + c]);
    uint64_t row = 0;
    for (uint m = 0; m < M; ++m) {
        precise float acc = 0.0;
        for (uint t = 0; t < 8; ++t) {
            if (t < taps) acc += win[t] * wt[t];
        }
        float xc = float(BF16(x + row).v[c]);
        acc += xc * w_x;
        precise float y = acc / (1.0 + exp(-acc));
        BF16(dst + row).v[c] = bfloat16_t(y);
        for (uint t = 0; t < 7; ++t) {
            if (t + 1 < taps) win[t] = win[t + 1];
        }
        for (uint t = 0; t < 8; ++t) {
            if (t + 1 == taps) win[t] = xc;
        }
        row += 2 * uint64_t(C);
    }
    for (uint t = 0; t < 8; ++t) {
        if (t < taps) window.v[c * taps + t] = bfloat16_t(win[t]);  // exact: bf16 values
    }
}
#endif
