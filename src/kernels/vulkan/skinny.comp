#version 460
// The kernels of src/kernels/metal/skinny.metal: small-M Q4/Q8 GEMMs with
// fp32 accumulation. The staged-A variants round dequantized weights to bf16
// like the dequant + GEMM fallback they replace; the register-A variants
// (m <= 8) dot the raw codes like the decode GEMV. The comments there say why
// each is as it is; the bodies (skinny_common.glsl) are the same arithmetic
// in the same order, except where a comment there says what differs. The
// 8-bit register-A body is quant_rows.glsl, which is not Metal's.
#include "common.glsl"
#include "quant_common.glsl"

// Staged variants: 128 threads (four weight rows) and one M block of 8 or 16
// rows.
#if defined(KERNEL_gemm_skinny_q4_bf16_m8) || defined(KERNEL_gemm_skinny_q4_f32_m8)
#define SKINNY_STAGED 4
#define SKINNY_MB 8
#endif
#if defined(KERNEL_gemm_skinny_q4_bf16_m16) || defined(KERNEL_gemm_skinny_q4_f32_m16)
#define SKINNY_STAGED 4
#define SKINNY_MB 16
#endif
#if defined(KERNEL_gemm_skinny_q8_bf16_m8) || defined(KERNEL_gemm_skinny_q8_f32_m8)
#define SKINNY_STAGED 8
#define SKINNY_MB 8
#endif
#if defined(KERNEL_gemm_skinny_q8_bf16_m16) || defined(KERNEL_gemm_skinny_q8_f32_m16)
#define SKINNY_STAGED 8
#define SKINNY_MB 16
#endif

// 8-bit register-A variants: the raw-code projection body (quant_rows.glsl)
