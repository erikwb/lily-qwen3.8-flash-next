// --- Causal prefill attention on the matrix units ------------------------------
//
// sdpa_nax_body<BQ, BK, SG, QDEV>: a threadgroup of FA_SG subgroups takes a
// tile of FA_BQ query rows of one head through the keys FA_BK at a time. The
// two matmul2d of the Metal kernel are 16x16x16 blocks here:
//   S[BQ, BK] = Q K^T    subgroup s computes the tile's key blocks 2s and
//                        2s + 1, each a walk over the head dim;
//   acc[BQ, D] += P V    subgroup s holds the accumulators of the head dims
//                        64s .. 64s + 63 as four blocks, each walked over the
//                        tile's eight key blocks.
// A key block wholly at or past the tile's causal end (k_end) is not
// computed: its scores are masked and its probabilities zero, which add
// nothing.
//
// How the operands reach the matrix units is this port's (matmul.glsl), the
// arithmetic and its order the first port's, which is kept test-only
// (tests/vulkan/attention_test.comp) and matched bit for bit. Twelve layers
// (`sdpa_small_m_timing`, 2026-11-10) of three rows over 1 100 positions,
// the verify pass of speculative decode: 3.35 ms with the first port, 1.60
// here; of 512 rows over 2 048: 19.7 and 11.3.
// - The query tile is staged once, in the lanes' order, not once per key
//   tile from device memory: a Q operand is one 16-byte load from
//   threadgroup memory. With three rows a threadgroup's time is the chain of
//   its key tiles, and the first port spent most of each tile's on eight
//   guarded 2-byte loads per lane and head-dim step for a tile of Q that is
//   the same for every key tile. 2.09 ms with this alone.
// - K and V are read by 4- and 8-byte loads at 32-bit indices (MAT_B_OF_PAIRS,
//   MAT_B_OF_ROWS), a key past the cache's rows clamped to the last (its
//   probability is zero); P is stored with a row's even keys and its odd
//   ones apart, so a lane's four are one load (MAT_A_OF_ELEMENTS), and the
//   scores four to a vector, so a softmax thread loads its sixteen in four.
// - A step's loads, of both operands, are issued before the first is used:
//   a thread waits at that use for all of them at once. 1.61 ms.
// What is left per key tile is its sixteen head-dim steps, its eight key
// blocks of P V and three barriers, each a wait or two: the chain a few
// rows cannot shorten in one threadgroup per head.
#ifdef KERNEL_sdpa_prefill_nax_qdev128
#define FA_BQ 16
#define FA_BK 128
#define FA_SG 4
#endif

// sdpa_rows_split_nax: the same tile for a chunk of at most FA_BQ rows (the
// verify pass of speculative decode), its keys split across threadgroups,
// one key tile each, as the split decode kernels do (no Metal counterpart:
// Metal runs sdpa_prefill_nax_qdev128 for these rows). One threadgroup per
// head walks a chain of key tiles, and with a few rows that chain is the
// kernel's time. Threadgroup (s, key head, t) takes key tile s for tile t of
// the rows of the key head's query heads (three rows of twelve heads: three
// tiles), keeps their softmax statistics and unnormalized P V in scratch,
// and sdpa_rows_split_combine adds the key tiles up. `sdpa_small_m_timing`,
// three rows, twelve layers, 2026-11-11: 1.64 ms with the prefill kernel at
// 1 100 keys (2.66 at 2 048), 0.61 split per head, 0.50 (0.55) with the
// heads folded into the tiles; the combine is 0.05 of it, a tile's Q K^T
// and P V about a third each. A tile's P is rounded to bf16 against its own
// row maxima rather than the running ones and the key tiles are summed in
// the combine rather than through the accumulator, so the result is the
// prefill kernel's to rounding, not bit for bit.
#ifdef KERNEL_sdpa_rows_split_nax
#define FA_BQ 16
#define FA_BK 128
#define FA_SG 4
#define FA_SPLIT
#endif

#ifdef FA_BQ
const uint FA_D = 256; // head dim (the model's, fixed)
const uint FA_LANES = 32 * FA_SG / FA_BQ;

// The scores, row-major, four keys to a vector.
shared vec4 s_tile[FA_BQ * FA_BK / 4];
// The probabilities: vector ((16 b + row) * 4 + 2 half + odd) holds keys
// 8 half + odd + 2 j, j in 0..4, of key block b: a lane's four elements of a
// row of the P operand (matmul.glsl).
shared bf16vec4 p_tile[FA_BQ * FA_BK / 4];
shared float row_max[FA_BQ], row_sum[FA_BQ], row_alpha[FA_BQ];
// The query tile in the lanes' order: vector 32 t + lane holds a lane's eight
// elements of the operand of head dims 16 t .. 16 t + 15.
shared uvec4 q_tile[FA_D / 16 * 32];

// S = Q K^T over the head dim for the subgroup's two key blocks. `k_at##b`
// are the elements of the lane's four keys of block b. A step's nine loads
// are issued before any is used (matmul.glsl: a thread waits at the first
// use, and a threadgroup's time here is its chain of steps).
#define FA_SCORES(pair)                                                                       \
    for (uint t = 0; t < FA_D / 16; ++t) {                                                    \
        uint d0 = 16 * t;                                                                     \
        uvec4 k0w = uvec4(pair(k_head, k_at0.x + d0), pair(k_head, k_at0.y + d0),             \
                          pair(k_head, k_at0.z + d0), pair(k_head, k_at0.w + d0));            \
        uvec4 k1w = uvec4(pair(k_head, k_at1.x + d0), pair(k_head, k_at1.y + d0),             \
                          pair(k_head, k_at1.z + d0), pair(k_head, k_at1.w + d0));            \
        uvec4 qw = q_tile[gl_SubgroupInvocationID + 32 * t];                                  \
        MatA mq;                                                                              \
        MatB mk;                                                                              \
        MAT_OF_WORDS(mq, qw)                                                                  \
        MAT_B_OF_PAIRS(mk, k0w.x, k0w.y, k0w.z, k0w.w)                                        \
        s_acc0 = coopMatMulAdd(mq, mk, s_acc0);                                               \
        MAT_B_OF_PAIRS(mk, k1w.x, k1w.y, k1w.z, k1w.w)                                        \
        s_acc1 = coopMatMulAdd(mq, mk, s_acc1);                                               \
    }
// acc += P V for the tile's key block b: `v_at` are the elements of the
// lane's two keys at the subgroup's first head dims.
#define FA_VALUE_LOAD(half, i) uvec2 v0w##i = half(v_head, v_at.x + 16 * i), v1w##i = half(v_head, v_at.y + 16 * i);
#define FA_VALUE_STEP(i)                                                                      \
    MAT_B_OF_ROWS(mv, v0w##i, v1w##i)                                                         \
    acc##i = coopMatMulAdd(mp, mv, acc##i);
#define FA_VALUES(half)                                                                       \
    for (uint b = 0; b < FA_BK / 16; ++b) {                                                   \
        int key0 = k0 + 16 * int(b);                                                          \
        if (key0 >= k_end) break;                                                             \
        uvec2 v_at = min(uvec2(key0) + uvec2(lane_row, lane_row + 1), uvec2(last_key)) * FA_D + (64 * sg + lane_col); \
        FA_VALUE_LOAD(half, 0) FA_VALUE_LOAD(half, 1) FA_VALUE_LOAD(half, 2) FA_VALUE_LOAD(half, 3) \
        bf16vec4 p0w = p_tile[p_at + 64 * b], p1w = p_tile[p_at + 64 * b + 4];                \
        MatA mp;                                                                              \
        MatB mv;                                                                              \
        MAT_A_OF_ELEMENTS(mp, p0w, p1w)                                                       \
        FA_VALUE_STEP(0) FA_VALUE_STEP(1) FA_VALUE_STEP(2) FA_VALUE_STEP(3)                   \
    }
#define FA_SCALE(i)                                                                           \
    for (uint e = 0; e < 4; ++e) acc##i[e] *= alpha0;                                         \
    for (uint e = 4; e < 8; ++e) acc##i[e] *= alpha1;
// A lane's four head dims of its two rows of an accumulator: one store each.
#define FA_STORE(i)                                                                           \
    for (uint h = 0; h < 2; ++h) {                                                            \
        uint row = uint(q0) + lane_row + h;                                                   \
        if (row < M) {                                                                        \
            vec4 o = vec4(acc##i[4 * h], acc##i[4 * h + 1], acc##i[4 * h + 2], acc##i[4 * h + 3]) / \
                     (h == 0 ? sum0 : sum1);                                                  \
            uint64_t o_row = arg(3) + 2 * (uint64_t(row * nq + hq) * FA_D);                   \
            if (wide_out) {                                                                   \
                MAT_STORE_HALF(o_row, 64 * sg + 16 * i + lane_col, o);                        \
            } else {                                                                          \
                MAT_STORE_HALF_UNALIGNED(o_row, 64 * sg + 16 * i + lane_col, o);              \
            }                                                                                 \
        }                                                                                     \
    }

void main() {
    uint max_seq = arg_u32(4), base_len = arg_u32(5), M = arg_u32(6), nq = arg_u32(7), group = arg_u32(8);
    float scale = arg_f32(9);
    uint parallel_softmax = arg_u32(10), descending_blocks = arg_u32(11);
    uvec2 tg = threadgroup_position_in_grid.xy;
    uint tid = thread_index_in_threadgroup, sg = simdgroup_index_in_threadgroup;

#ifdef FA_SPLIT
    // Arguments 10 and 11 are the scratch's split count and nothing. The
    // tile's rows are the chunk's rows of the key head's `group` query
    // heads: row p is chunk row p % M of head p / M of the group, so the
    // group's heads share one read of the keys.
    uint splits = parallel_softmax, split = tg.x;
    uint qb = threadgroup_position_in_grid.z;
    uint kv = tg.y, n_rows = M * group;
#define FA_ROW_T(p) ((p) % M)
#define FA_ROW_HEAD(p) (kv * group + (p) / M)
#else
    uint qb = descending_blocks != 0u ? ((M + FA_BQ - 1) / FA_BQ) - 1u - tg.x : tg.x;
    uint kv = tg.y / group, n_rows = M;
#endif
    int q0 = int(qb) * FA_BQ;
    uint hq = tg.y;
    int len_total = int(base_len) + int(M);

    // Tile layout requires SG * 32 threads.
    if (threads_per_threadgroup.x != 32 * FA_SG) return;
    if (tid < FA_BQ) {
        row_max[tid] = NEG_INFINITY;
        row_sum[tid] = 0.0;
    }

    uint64_t k_head = arg(1) + 2 * (uint64_t(kv) * max_seq * FA_D);
    uint64_t v_head = arg(2) + 2 * (uint64_t(kv) * max_seq * FA_D);
    uint q_valid = min(uint(FA_BQ), n_rows - uint(q0));
#ifdef FA_SPLIT
    uint64_t q_rows = arg(0);
#define FA_Q_ROW(r) ((FA_ROW_T(uint(q0) + (r)) * nq + FA_ROW_HEAD(uint(q0) + (r))) * FA_D)
#else
    // The tile's query rows: row r of it is q_stride elements after row r - 1.
    uint64_t q_rows = arg(0) + 2 * (uint64_t(uint(q0) * nq + hq) * FA_D);
    uint q_stride = nq * FA_D;
#define FA_Q_ROW(r) ((r) * q_stride)
#endif
    bool wide = ((arg(0) | arg(1) | arg(2)) & 3) == 0, wide_out = (arg(3) & 3) == 0;

    // The query tile, once: a thread assembles four lanes' operands of one
    // head-dim step, each the even or the odd bfloats of eight head dims of
    // two rows (a row past M reads the last: its scores are never used).
    {
        uint t = tid / 8;
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            uint lane = 4 * (tid % 8) + j;
            uint row = (lane & 6) | ((lane >> 1) & 8);
            uint d = 16 * t + 8 * (lane & 1), odd16 = 16 * ((lane >> 3) & 1);
            uint at0 = FA_Q_ROW(min(row, q_valid - 1)) + d, at1 = FA_Q_ROW(min(row + 1, q_valid - 1)) + d;
            uvec4 w0, w1;
            if (wide) {
                w0 = MAT_VECTOR(q_rows, at0);
                w1 = MAT_VECTOR(q_rows, at1);
            } else {
                w0 = MAT_VECTOR_UNALIGNED(q_rows, at0);
                w1 = MAT_VECTOR_UNALIGNED(q_rows, at1);
            }
            w0 = (w0 >> odd16) & 0xFFFFu;
            w1 = (w1 >> odd16) & 0xFFFFu;
            q_tile[32 * t + lane] = uvec4(w0.x | (w0.y << 16), w0.z | (w0.w << 16), w1.x | (w1.y << 16), w1.z | (w1.w << 16));
        }
    }
    barrier();

    uint lane_row = mat_lane_row(), lane_col = mat_lane_col();
    uint p_at = lane_row * 4 + 2 * mat_a_half() + mat_a_odd();
    uint last_key = uint(len_total) - 1;

    MatC acc0 = MatC(0.0), acc1 = MatC(0.0), acc2 = MatC(0.0), acc3 = MatC(0.0);

#ifdef FA_SPLIT
    int k_end = len_total;
    // The grid is sized for the largest length the host allows.
    if (int(split) * int(FA_BK) >= k_end) return;
    {
        int k0 = int(split) * int(FA_BK);
#else
    int k_end = min(len_total, int(base_len) + q0 + FA_BQ);
    for (int k0 = 0; k0 < k_end; k0 += FA_BK) {
#endif
        // S = Q K^T.
        int key_s = k0 + 32 * int(sg);
        if (key_s < k_end) {
            MatC s_acc0 = MatC(0.0), s_acc1 = MatC(0.0);
            // The lane's four keys of each block (a key past the cache's
            // rows reads the last: its score is masked), at its two rows of
            // the head dim.
            uvec4 keys = uvec4(key_s) + lane_col + uvec4(0, 1, 2, 3);
            uvec4 k_at0 = min(keys, uvec4(last_key)) * FA_D + lane_row;
            uvec4 k_at1 = min(keys + 16, uvec4(last_key)) * FA_D + lane_row;
            if (wide) {
                FA_SCORES(MAT_PAIR)
            } else {
                FA_SCORES(MAT_PAIR_UNALIGNED)
            }
            coopMatStore(s_acc0, s_tile, 8 * sg, FA_BK / 4, gl_CooperativeMatrixLayoutRowMajor);
            if (key_s + 16 < k_end) coopMatStore(s_acc1, s_tile, 8 * sg + 4, FA_BK / 4, gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();

        // The parallel reduction is not bit-identical to the serial path.
#ifdef FA_SPLIT
        if (true) {
#else
        if (parallel_softmax != 0u) {
#endif
            uint row = tid / FA_LANES;
            uint lane8 = tid % FA_LANES;
            const uint cols = FA_BK / FA_LANES;
            uint j0 = lane8 * cols;
#ifdef FA_SPLIT
            int grow = int(FA_ROW_T(min(uint(q0) + row, n_rows - 1)));
#else
            int grow = q0 + int(row);
#endif
            int limit = min(min(int(base_len) + grow + 1, len_total) - k0, FA_BK);
            float prev_max = row_max[row];
            float local = prev_max;
            // This lane's scores, read once for both loops of the Metal kernel.
            vec4 sv[cols / 4];
            [[unroll]] for (uint j = 0; j < cols / 4; ++j) sv[j] = s_tile[(row * FA_BK + j0) / 4 + j] * scale;
            [[unroll]] for (uint j = 0; j < cols; ++j) {
                if (int(j0 + j) < limit) local = max(local, sv[j / 4][j % 4]);
            }
            for (uint off = 1u; off < FA_LANES; off <<= 1) local = max(local, subgroupShuffleXor(local, off));
            float mx = local;
            float alpha = exp(prev_max - mx);
            float psum = 0.0;
            float p[cols];
            [[unroll]] for (uint j = 0; j < cols; ++j) {
                p[j] = int(j0 + j) < limit ? exp(sv[j / 4][j % 4] - mx) : 0.0;
                psum += p[j];
            }
            // Key block lane8 of the row: its two halves' even keys and odd ones.
            [[unroll]] for (uint j = 0; j < 4; ++j) {
                uint c = 8 * (j / 2) + (j % 2);
                p_tile[(16 * lane8 + row) * 4 + j] = bf16(vec4(p[c], p[c + 2], p[c + 4], p[c + 6]));
            }
            for (uint off = 1u; off < FA_LANES; off <<= 1) psum += subgroupShuffleXor(psum, off);
            if (lane8 == 0u) {
#ifdef FA_SPLIT
                // One tile: nothing to rescale (and a row with no key here
                // has mx and prev_max both -inf, alpha NaN).
                alpha = 0.0;
#endif
                row_sum[row] = row_sum[row] * alpha + psum;
                row_max[row] = mx;
                row_alpha[row] = alpha;
            }
        } else if (tid < FA_BQ) {
            int grow = q0 + int(tid);
            int limit = min(min(int(base_len) + grow + 1, len_total) - k0, FA_BK);
            float mx = row_max[tid];
            for (int j = 0; j < limit; ++j) mx = max(mx, s_tile[(tid * FA_BK + j) / 4][j % 4] * scale);
            float alpha = exp(row_max[tid] - mx);
            float s = row_sum[tid] * alpha;
            for (int j0 = 0; j0 < FA_BK; j0 += 8) {
                // Eight keys: a vector of the even ones and one of the odd.
                float p[8];
                for (int j = 0; j < 8; ++j) {
                    p[j] = j0 + j < limit ? exp(s_tile[(tid * FA_BK + j0 + j) / 4][(j0 + j) % 4] * scale - mx) : 0.0;
                    s += j0 + j < limit ? p[j] : 0.0;
                }
                uint at = (uint(j0) / 16 * 16 + tid) * 4 + 2 * (uint(j0) / 8 % 2);
                p_tile[at] = bf16(vec4(p[0], p[2], p[4], p[6]));
                p_tile[at + 1] = bf16(vec4(p[1], p[3], p[5], p[7]));
            }
            row_max[tid] = mx;
            row_sum[tid] = s;
            row_alpha[tid] = alpha;
        }
        barrier();

        // acc = acc * alpha[row] + P V. A lane's elements of a block are in
        // two rows, four each.
#ifndef FA_SPLIT
        {
            float alpha0 = row_alpha[lane_row], alpha1 = row_alpha[lane_row + 1];
            FA_SCALE(0) FA_SCALE(1) FA_SCALE(2) FA_SCALE(3)
        }
#endif
        if (wide) {
            FA_VALUES(MAT_HALF)
        } else {
            FA_VALUES(MAT_HALF_UNALIGNED)
        }
        // Finish the matrix ops before reusing p_tile and s_tile.
        barrier();
    }

#ifdef FA_SPLIT
    // Row r's P V and statistics of tile `split`: entry (r * nq + hq) *
    // splits + split of the scratch (argument 3: P V, f32 [M * nq * splits,
    // D], then the row maximum of the scaled scores and the sum of P, f32
    // [M * nq * splits, 2]).
    {
        uint64_t part = arg(3), stats = arg(3) + 4 * (uint64_t(M * nq * splits) * FA_D);
        [[unroll]] for (uint h = 0; h < 2; ++h) {
            uint p = uint(q0) + lane_row + h;
            if (p < n_rows) {
                uint at = ((FA_ROW_T(p) * nq + FA_ROW_HEAD(p)) * splits + split) * FA_D + 64 * sg + lane_col;
                F32x4 o = F32x4(part);
                o.v[at / 4] = vec4(acc0[4 * h], acc0[4 * h + 1], acc0[4 * h + 2], acc0[4 * h + 3]);
                o.v[at / 4 + 4] = vec4(acc1[4 * h], acc1[4 * h + 1], acc1[4 * h + 2], acc1[4 * h + 3]);
                o.v[at / 4 + 8] = vec4(acc2[4 * h], acc2[4 * h + 1], acc2[4 * h + 2], acc2[4 * h + 3]);
                o.v[at / 4 + 12] = vec4(acc3[4 * h], acc3[4 * h + 1], acc3[4 * h + 2], acc3[4 * h + 3]);
            }
        }
        if (uint(q0) + tid < n_rows && tid < FA_BQ) {
            uint p = uint(q0) + tid;
            uint at = (FA_ROW_T(p) * nq + FA_ROW_HEAD(p)) * splits + split;
            F32(stats).v[2 * at] = row_max[tid];
            F32(stats).v[2 * at + 1] = row_sum[tid];
        }
    }
#else
    {
        float sum0 = row_sum[lane_row], sum1 = row_sum[lane_row + 1];
        FA_STORE(0) FA_STORE(1) FA_STORE(2) FA_STORE(3)
    }
#endif
}
#endif

// The rows' outputs from sdpa_rows_split_nax's tiles: threadgroup (head,
// row), a thread per four head dims. The tiles of a row past its keys hold
// a maximum of -inf and add nothing; tiles past the length were not run.
#ifdef KERNEL_sdpa_rows_split_combine
void main() {
    // Arguments: the split kernel's scratch, the output [M, nq, 256].
    uint base_len = arg_u32(2), M = arg_u32(3), nq = arg_u32(4), splits = arg_u32(5);
    uint hq = threadgroup_position_in_grid.x, row = threadgroup_position_in_grid.y;
    uint d4 = thread_index_in_threadgroup;
    uint n = min(splits, (base_len + M + 127u) / 128u);
    uint first = (row * nq + hq) * splits;
    F32 stats = F32(arg(0) + 4 * (uint64_t(M * nq * splits) * 256));
    float m = NEG_INFINITY;
    for (uint s = 0; s < n; ++s) m = max(m, stats.v[2 * (first + s)]);
    float l = 0.0;
    vec4 acc = vec4(0.0);
    F32x4 part = F32x4(arg(0));
    for (uint s = 0; s < n; ++s) {
        vec2 st = vec2(stats.v[2 * (first + s)], stats.v[2 * (first + s) + 1]);
        float w = exp(st.x - m);
        l += w * st.y;
        acc += w * part.v[(first + s) * 64 + d4];
    }
    uint64_t o_row = arg(1) + 2 * (uint64_t(row * nq + hq) * 256);
    U32x2(o_row).v[d4] = mat_bf16_words(acc / l);
}
#endif

// --- Decode attention ------------------------------------------------------------

// Single-token GQA SDPA with one threadgroup per query head.
#ifdef KERNEL_sdpa_decode_bf16
shared float scores[MAX_T];
shared float q_s[TG]; // D <= TG assumed
shared float part[TG / 32];
shared float red;
void main() {
    uint D = arg_u32(4), max_seq = arg_u32(5), len = arg_u32(6), group = arg_u32(7);
    float scale = arg_f32(8);
    uint hq = threadgroup_position_in_grid.x, tid = thread_index_in_threadgroup;
    uint sg = simdgroup_index_in_threadgroup, lane = thread_index_in_simdgroup;

    BF16 k_head = BF16(arg(1) + 2 * (uint64_t(hq / group) * max_seq * D));
    BF16 v_head = BF16(arg(2) + 2 * (uint64_t(hq / group) * max_seq * D));

    if (tid < D) q_s[tid] = float(BF16(arg(0)).v[hq * D + tid]);
    barrier();

    float local_max = NEG_INFINITY;
    for (uint pos = tid; pos < len; pos += TG) {
        float dp = 0.0;
        for (uint d = 0; d < D; ++d) dp += q_s[d] * float(k_head.v[pos * D + d]);
        float s = dp * scale;
        scores[pos] = s;
        local_max = max(local_max, s);
    }

    local_max = subgroupMax(local_max);
    if (lane == 0) part[sg] = local_max;
    barrier();
    if (tid == 0) {
        float m = NEG_INFINITY;
        for (uint i = 0; i < TG / 32; ++i) m = max(m, part[i]);
        red = m;
    }
    barrier();
    float global_max = red;

    float local_sum = 0.0;
    for (uint pos = tid; pos < len; pos += TG) {
        float e = exp(scores[pos] - global_max);
        scores[pos] = e;
        local_sum += e;
    }
    local_sum = subgroupAdd(local_sum);
    barrier();
    if (lane == 0) part[sg] = local_sum;
    barrier();
    if (tid == 0) {
        float s = 0.0;
        for (uint i = 0; i < TG / 32; ++i) s += part[i];
        red = s;
    }
    barrier();
    float inv_sum = 1.0 / red;

    for (uint d = tid; d < D; d += TG) {
        float acc = 0.0;
        for (uint pos = 0; pos < len; ++pos) acc += scores[pos] * float(v_head.v[pos * D + d]);
        BF16(arg(3)).v[hq * D + d] = bfloat16_t(acc * inv_sum);
    }
}
#endif

// Split-K decode emits local softmax statistics and weighted-V partials.
#define SDPA_SPLIT 256

// sdpa_decode_split_t<CPT, STRIDED>.
#ifdef KERNEL_sdpa_decode_split_bf16
#define SPLIT_CPT 1
#define SPLIT_STRIDED 0
#endif

#ifdef SPLIT_CPT
shared float scores[SDPA_SPLIT];
shared float q_s[TG];
shared float part[TG / 32];
shared float red;
shared float v_stage[(TG / 32) * 256];
void main() {
    uint D = arg_u32(5), max_seq = arg_u32(6), len = arg_u32(7), splits = arg_u32(8), group = arg_u32(9);
    float scale = arg_f32(10);
    uvec2 tg = threadgroup_position_in_grid.xy;
    uint tid = thread_index_in_threadgroup;
    uint sg = simdgroup_index_in_threadgroup, lane = thread_index_in_simdgroup;
    F32 stats = F32(arg(4));

    uint hq = tg.x;
    uint64_t k_head = arg(1) + 2 * (uint64_t(hq / group) * max_seq * D);
    uint64_t v_head = arg(2) + 2 * (uint64_t(hq / group) * max_seq * D);

    for (uint cc = 0; cc < SPLIT_CPT; ++cc) {
        uint split = SPLIT_STRIDED != 0 ? (tg.y + cc * ((splits + SPLIT_CPT - 1) / SPLIT_CPT))
                                        : (tg.y * SPLIT_CPT + cc);
        if (split >= splits) continue;
        uint base = split * SDPA_SPLIT;
        uint count = base < len ? min(uint(SDPA_SPLIT), len - base) : 0;

        if (count == 0) {
            if (tid == 0) {
                stats.v[(hq * splits + split) * 2] = NEG_INFINITY;
                stats.v[(hq * splits + split) * 2 + 1] = 0.0;
            }
            barrier();
            continue;
        }

        if (tid < D) q_s[tid] = float(BF16(arg(0)).v[hq * D + tid]);
        barrier();

        float local_max = NEG_INFINITY;
        if (D % 8 == 0) {
            // With D <= TG the Metal loop over i has the one step i = lane
            // (none for a lane past D / 8), so the lane's eight q come out
            // of threadgroup memory once, not per key row.
            bool has = lane * 8 < D;
            vec4 qa = vec4(0.0), qb = vec4(0.0);
            if (has) {
                qa = vec4(q_s[lane * 8], q_s[lane * 8 + 1], q_s[lane * 8 + 2], q_s[lane * 8 + 3]);
                qb = vec4(q_s[lane * 8 + 4], q_s[lane * 8 + 5], q_s[lane * 8 + 6], q_s[lane * 8 + 7]);
            }
            U32x4 k_rows = U32x4(k_head);
            for (uint p = sg; p < count; p += TG / 32) {
                float dp = 0.0;
                if (has) {
                    uvec4 kq = k_rows.v[(base + p) * (D / 8) + lane];
                    dp += dot(bf4(kq.xy), qa);
                    dp += dot(bf4(kq.zw), qb);
                }
                dp = subgroupAdd(dp);
                float s = dp * scale;
                if (lane == 0) scores[p] = s;
                local_max = max(local_max, s);
            }
        } else {
            if (tid < count) {
                float dp = 0.0;
                for (uint d = 0; d < D; ++d) dp += q_s[d] * float(BF16(k_head).v[(base + tid) * D + d]);
                float s = dp * scale;
                scores[tid] = s;
                local_max = s;
            }
        }
        local_max = subgroupMax(local_max);
        if (lane == 0) part[sg] = local_max;
        barrier();
        if (tid == 0) {
            float m = NEG_INFINITY;
            for (uint i = 0; i < TG / 32; ++i) m = max(m, part[i]);
            red = m;
        }
        barrier();
        float chunk_max = red;

        float e = 0.0;
        if (tid < count) {
            e = exp(scores[tid] - chunk_max);
            scores[tid] = e;
        }
        float local_sum = subgroupAdd(e);
        barrier();
        if (lane == 0) part[sg] = local_sum;
        barrier();
        if (tid == 0) {
            float s = 0.0;
            for (uint i = 0; i < TG / 32; ++i) s += part[i];
            stats.v[(hq * splits + split) * 2] = chunk_max;
            stats.v[(hq * splits + split) * 2 + 1] = s;
        }
        barrier();

        // Reduce per-simdgroup weighted-V accumulators.
        F32 partials = F32(arg(3) + 4 * ((uint64_t(hq) * splits + split) * D));
        if (D % 8 == 0 && D <= 8 * 32) {
            vec4 acc0 = vec4(0.0);
            vec4 acc1 = vec4(0.0);
            U32x4 v_rows = U32x4(v_head);
            for (uint p = sg; p < count; p += TG / 32) {
                float wgt = scores[p];
                if (lane * 8 < D) {
                    uvec4 vq = v_rows.v[(base + p) * (D / 8) + lane];
                    acc0 += wgt * bf4(vq.xy);
                    acc1 += wgt * bf4(vq.zw);
                }
            }
            if (lane * 8 < D) {
                for (uint j = 0; j < 4; ++j) {
                    v_stage[sg * D + lane * 8 + j] = acc0[j];
                    v_stage[sg * D + lane * 8 + 4 + j] = acc1[j];
                }
            }
            barrier();
            for (uint d = tid; d < D; d += TG) {
                float acc = 0.0;
                for (uint s = 0; s < TG / 32; ++s) acc += v_stage[s * D + d];
                partials.v[d] = acc;
            }
        } else {
            for (uint d = tid; d < D; d += TG) {
                float acc = 0.0;
                for (uint p = 0; p < count; ++p) acc += scores[p] * float(BF16(v_head).v[(base + p) * D + d]);
                partials.v[d] = acc;
            }
        }
        barrier();
    }
}
#endif

// sdpa_decode_split_bf16 over a q8 cache (D = 256: lane l holds dims
// 8l..8l+7, inside group l / 4).
#ifdef KERNEL_sdpa_decode_split_q8
shared float scores[SDPA_SPLIT];
shared float q_s[TG];
shared float part[TG / 32];
shared float red;
shared float v_stage[(TG / 32) * 256];
void main() {
    uint D = arg_u32(7), max_seq = arg_u32(8), len = arg_u32(9), splits = arg_u32(10), group = arg_u32(11);
    float scale = arg_f32(12);
    uvec2 tg = threadgroup_position_in_grid.xy;
    uint tid = thread_index_in_threadgroup;
    uint sg = simdgroup_index_in_threadgroup, lane = thread_index_in_simdgroup;
    F32 stats = F32(arg(6));

    uint hq = tg.x;
    uint split = tg.y;
    uint groups = D / KV_Q8_GROUP;
    uint64_t head_row = uint64_t(hq / group) * max_seq;
    // This lane's eight bytes of a head's row t: k_head.v[t * D / 8].
    U32x2 k_head = U32x2(arg(1) + head_row * D + lane * 8);
    U32x2 v_head = U32x2(arg(3) + head_row * D + lane * 8);
    F16 ks_head = F16(arg(2) + 2 * (head_row * groups));
    F16 vs_head = F16(arg(4) + 2 * (head_row * groups));
    uint base = split * SDPA_SPLIT;
    uint count = base < len ? min(uint(SDPA_SPLIT), len - base) : 0;

    if (count == 0) {
        if (tid == 0) {
            stats.v[(hq * splits + split) * 2] = NEG_INFINITY;
            stats.v[(hq * splits + split) * 2 + 1] = 0.0;
        }
        return;
    }

    if (tid < D) q_s[tid] = float(BF16(arg(0)).v[hq * D + tid]);
    barrier();

    float local_max = NEG_INFINITY;
    vec4 qa = vec4(q_s[lane * 8], q_s[lane * 8 + 1], q_s[lane * 8 + 2], q_s[lane * 8 + 3]);
    vec4 qb = vec4(q_s[lane * 8 + 4], q_s[lane * 8 + 5], q_s[lane * 8 + 6], q_s[lane * 8 + 7]);
    for (uint p = sg; p < count; p += TG / 32) {
        uint t = base + p;
        uvec2 kq = k_head.v[t * (D / 8)];
        float ks = float(ks_head.v[t * groups + lane / 4]);
        float dp = dot(char4(kq.x), qa) + dot(char4(kq.y), qb);
        dp = subgroupAdd(dp * ks);
        float s = dp * scale;
        if (lane == 0) scores[p] = s;
        local_max = max(local_max, s);
    }
    local_max = subgroupMax(local_max);
    if (lane == 0) part[sg] = local_max;
    barrier();
    if (tid == 0) {
        float m = NEG_INFINITY;
        for (uint i = 0; i < TG / 32; ++i) m = max(m, part[i]);
        red = m;
    }
    barrier();
    float chunk_max = red;

    float e = 0.0;
    if (tid < count) {
        e = exp(scores[tid] - chunk_max);
        scores[tid] = e;
    }
    float local_sum = subgroupAdd(e);
    barrier();
    if (lane == 0) part[sg] = local_sum;
    barrier();
    if (tid == 0) {
        float s = 0.0;
        for (uint i = 0; i < TG / 32; ++i) s += part[i];
        stats.v[(hq * splits + split) * 2] = chunk_max;
        stats.v[(hq * splits + split) * 2 + 1] = s;
    }
    barrier();

    vec4 acc0 = vec4(0.0);
    vec4 acc1 = vec4(0.0);
    for (uint p = sg; p < count; p += TG / 32) {
        uint t = base + p;
        float wgt = scores[p] * float(vs_head.v[t * groups + lane / 4]);
        uvec2 vq = v_head.v[t * (D / 8)];
        acc0 += wgt * char4(vq.x);
        acc1 += wgt * char4(vq.y);
    }
    for (uint j = 0; j < 4; ++j) {
        v_stage[sg * D + lane * 8 + j] = acc0[j];
        v_stage[sg * D + lane * 8 + 4 + j] = acc1[j];
    }
    barrier();
    F32 partials = F32(arg(5) + 4 * ((uint64_t(hq) * splits + split) * D));
    for (uint d = tid; d < D; d += TG) {
        float acc = 0.0;
        for (uint s = 0; s < TG / 32; ++s) acc += v_stage[s * D + d];
        partials.v[d] = acc;
    }
}
#endif

// Folded GQA reuses each K/V row across query heads:
// sdpa_decode_split_gqa_t<HPP, GCPT, HPT, RIF, SERIAL, FIXED>.
#ifdef KERNEL_sdpa_decode_split_gqa_h4u_bf16
#define GQA_HPP 4
#define GQA_GCPT 1
#define GQA_HPT 4
#define GQA_RIF 1
#define GQA_SERIAL 0
#define GQA_FIXED 1
#endif

#ifdef GQA_HPP
#define MAX_GQA 8
shared float scores[GQA_HPP][SDPA_SPLIT];
shared float part[GQA_HPP][TG / 32];
shared float red[GQA_HPP];
shared float v_stage[(TG / 32) * 256];
void main() {
    uint D = arg_u32(5), max_seq = arg_u32(6), len = arg_u32(7), splits = arg_u32(8), group = arg_u32(9);
    float scale = arg_f32(10);
    uint chunk = arg_u32(11); // <= SDPA_SPLIT
    uvec2 tg = threadgroup_position_in_grid.xy;
    uint tid = thread_index_in_threadgroup;
    uint sg = simdgroup_index_in_threadgroup, lane = thread_index_in_simdgroup;
    F32 stats = F32(arg(4));

    uint gfull = min(group, uint(MAX_GQA));
    uint sub = GQA_HPT != 0 ? max(1u, gfull / uint(GQA_HPT)) : 1u;
    uint kh = tg.x / sub;
    uint hbase = (tg.x % sub) * (GQA_HPT != 0 ? uint(GQA_HPT) : gfull);
    uint g = GQA_HPT != 0 ? min(uint(GQA_HPT), gfull - hbase) : gfull;
    for (uint gcc = 0; gcc < GQA_GCPT; ++gcc) {
        uint split = tg.y + gcc * ((splits + GQA_GCPT - 1) / GQA_GCPT);
        if (split >= splits) continue;
        uint c = min(chunk, uint(SDPA_SPLIT));
        uint base = split * c;
        uint count = base < len ? min(c, len - base) : 0;
        // A head's rows by uint4: row t, dims 8 lane.. is at t * D / 8 + lane.
        U32x4 k_head = U32x4(arg(1) + 2 * (uint64_t(kh) * max_seq * D));
        U32x4 v_head = U32x4(arg(2) + 2 * (uint64_t(kh) * max_seq * D));

        if (count == 0) {
            if (tid == 0) {
                for (uint h = 0; h < g; ++h) {
                    uint hq = kh * gfull + hbase + h;
                    stats.v[(hq * splits + split) * 2] = NEG_INFINITY;
                    stats.v[(hq * splits + split) * 2 + 1] = 0.0;
                }
            }
            barrier();
            continue;
        }

        // Each lane holds eight Q dimensions per head.
        for (uint h0 = 0; h0 < g; h0 += GQA_HPP) {
            uint gh = GQA_FIXED != 0 ? uint(GQA_HPP) : min(uint(GQA_HPP), g - h0);
            vec4 qa[GQA_HPP];
            vec4 qb[GQA_HPP];
            for (uint h = 0; h < gh; ++h) {
                uint hq = kh * gfull + hbase + h0 + h;
                BF16x4 qh = BF16x4(arg(0) + 2 * (uint64_t(hq) * D + lane * 8));
                qa[h] = vec4(qh.v[0]);
                qb[h] = vec4(qh.v[1]);
            }

            float local_max[GQA_HPP];
            for (uint h = 0; h < gh; ++h) local_max[h] = NEG_INFINITY;

            // Uniform tail guards preserve full-simdgroup reductions.
            const uint kstride = TG / 32;
            for (uint p0 = sg; p0 < count; p0 += GQA_RIF * kstride) {
#define GQA_ROW(HEAD, P) HEAD.v[(base + (P)) * (D / 8) + lane]
                uvec4 r0 = GQA_ROW(k_head, p0);
                uvec4 r1, r2, r3;
                bool h1 = GQA_RIF > 1 && p0 + kstride < count;
                bool h2 = GQA_RIF > 2 && p0 + 2 * kstride < count;
                bool h3 = GQA_RIF > 3 && p0 + 3 * kstride < count;
                uint dep1 = GQA_SERIAL != 0 ? uint(r0.x == 0xFFFFFFFFu) : 0u;
                if (h1) r1 = GQA_ROW(k_head, p0 + kstride + dep1);
                uint dep2 = GQA_SERIAL != 0 ? uint(r1.x == 0xFFFFFFFFu) : 0u;
                if (h2) r2 = GQA_ROW(k_head, p0 + 2 * kstride + dep2);
                uint dep3 = GQA_SERIAL != 0 ? uint(r2.x == 0xFFFFFFFFu) : 0u;
                if (h3) r3 = GQA_ROW(k_head, p0 + 3 * kstride + dep3);
#define GQA_K_CONSUME(P, ROW)                              \
    {                                                      \
        vec4 ka = bf4((ROW).xy);                           \
        vec4 kb = bf4((ROW).zw);                           \
        for (uint h = 0; h < gh; ++h) {                    \
            float dp = 0.0;                                \
            dp += dot(ka, qa[h]);                          \
            dp += dot(kb, qb[h]);                          \
            dp = subgroupAdd(dp);                          \
            float s = dp * scale;                          \
            if (lane == 0) scores[h][(P)] = s;             \
            local_max[h] = max(local_max[h], s);           \
        }                                                  \
    }
                GQA_K_CONSUME(p0, r0)
                if (h1) GQA_K_CONSUME(p0 + kstride, r1)
                if (h2) GQA_K_CONSUME(p0 + 2 * kstride, r2)
                if (h3) GQA_K_CONSUME(p0 + 3 * kstride, r3)
            }

            for (uint h = 0; h < gh; ++h) {
                float m = subgroupMax(local_max[h]);
                if (lane == 0) part[h][sg] = m;
            }
            barrier();
            if (tid == 0) {
                for (uint h = 0; h < gh; ++h) {
                    float m = NEG_INFINITY;
                    for (uint i = 0; i < TG / 32; ++i) m = max(m, part[h][i]);
                    red[h] = m;
                }
            }
            barrier();

            for (uint h = 0; h < gh; ++h) {
                float chunk_max = red[h];
                float e = 0.0;
                if (tid < count) {
                    e = exp(scores[h][tid] - chunk_max);
                    scores[h][tid] = e;
                }
                float local_sum = subgroupAdd(e);
                barrier();
                if (lane == 0) part[h][sg] = local_sum;
                barrier();
                if (tid == 0) {
                    float s = 0.0;
                    for (uint i = 0; i < TG / 32; ++i) s += part[h][i];
                    uint hq = kh * gfull + hbase + h0 + h;
                    stats.v[(hq * splits + split) * 2] = chunk_max;
                    stats.v[(hq * splits + split) * 2 + 1] = s;
                }
                barrier();
            }

            // Stage one head at a time while reusing V rows.
            vec4 acc0[GQA_HPP];
            vec4 acc1[GQA_HPP];
            for (uint h = 0; h < gh; ++h) {
                acc0[h] = vec4(0.0);
                acc1[h] = vec4(0.0);
            }
            const uint vstride = TG / 32;
            for (uint p0 = sg; p0 < count; p0 += GQA_RIF * vstride) {
                uvec4 s0 = GQA_ROW(v_head, p0);
                uvec4 s1, s2, s3;
                bool g1 = GQA_RIF > 1 && p0 + vstride < count;
                bool g2 = GQA_RIF > 2 && p0 + 2 * vstride < count;
                bool g3 = GQA_RIF > 3 && p0 + 3 * vstride < count;
                uint vdep1 = GQA_SERIAL != 0 ? uint(s0.x == 0xFFFFFFFFu) : 0u;
                if (g1) s1 = GQA_ROW(v_head, p0 + vstride + vdep1);
                uint vdep2 = GQA_SERIAL != 0 ? uint(s1.x == 0xFFFFFFFFu) : 0u;
                if (g2) s2 = GQA_ROW(v_head, p0 + 2 * vstride + vdep2);
                uint vdep3 = GQA_SERIAL != 0 ? uint(s2.x == 0xFFFFFFFFu) : 0u;
                if (g3) s3 = GQA_ROW(v_head, p0 + 3 * vstride + vdep3);
#define GQA_V_WEIGH(P, ROW)                                \
    {                                                      \
        vec4 va = bf4((ROW).xy);                           \
        vec4 vb = bf4((ROW).zw);                           \
        for (uint h = 0; h < gh; ++h) {                    \
            float wgt = scores[h][(P)];                    \
            acc0[h] += wgt * va;                           \
            acc1[h] += wgt * vb;                           \
        }                                                  \
    }
                GQA_V_WEIGH(p0, s0)
                if (g1) GQA_V_WEIGH(p0 + vstride, s1)
                if (g2) GQA_V_WEIGH(p0 + 2 * vstride, s2)
                if (g3) GQA_V_WEIGH(p0 + 3 * vstride, s3)
            }
            for (uint h = 0; h < gh; ++h) {
                for (uint j = 0; j < 4; ++j) {
                    v_stage[sg * D + lane * 8 + j] = acc0[h][j];
                    v_stage[sg * D + lane * 8 + 4 + j] = acc1[h][j];
                }
                barrier();
                uint hq = kh * gfull + hbase + h0 + h;
                F32 partials = F32(arg(3) + 4 * ((uint64_t(hq) * splits + split) * D));
                for (uint d = tid; d < D; d += TG) {
                    float acc = 0.0;
                    for (uint s = 0; s < TG / 32; ++s) acc += v_stage[s * D + d];
                    partials.v[d] = acc;
                }
                barrier();
            }
        }
    }
}
#endif

// Fixed-block decode (adapted from MLX sdpa_vector_2pass_1; see NOTICE): a
// subgroup takes two query heads through every 128th cache row from its
// block, two rows a step.
#ifdef KERNEL_sdpa_decode_mlx_b128h2r2
#define MLX_DECL(j)                                                                    \
    vec4 qa##j, qb##j, aa##j = vec4(0.0), ab##j = vec4(0.0);                           \
    float m##j = NEG_INFINITY, l##j = 0.0;                                             \
    {                                                                                  \
        BF16x4 qh = BF16x4(arg(0) + 2 * (uint64_t(hq0 + j) * D + lane * 8));           \
        qa##j = vec4(qh.v[0]);                                                         \
        qb##j = vec4(qh.v[1]);                                                         \
    }

#define MLX_SCORE2(j)                                                                  \
    float w##j##_0, w##j##_1;                                                          \
    {                                                                                  \
        float s0 = subgroupAdd(dot(ka0, qa##j) + dot(kb0, qb##j)) * scale;             \
        float s1 = NEG_INFINITY;                                                       \
        if (have1) s1 = subgroupAdd(dot(ka1, qa##j) + dot(kb1, qb##j)) * scale;        \
        float nm = max(m##j, max(s0, s1));                                             \
        float c = exp(m##j - nm);                                                      \
        w##j##_0 = exp(s0 - nm);                                                       \
        w##j##_1 = have1 ? exp(s1 - nm) : 0.0;                                         \
        l##j = l##j * c + w##j##_0 + w##j##_1;                                         \
        m##j = nm;                                                                     \
        aa##j *= c;                                                                    \
        ab##j *= c;                                                                    \
    }

#define MLX_ACC2(j)                                                                    \
    aa##j += w##j##_0 * va0 + w##j##_1 * va1;                                          \
    ab##j += w##j##_0 * vb0 + w##j##_1 * vb1;

#define MLX_STORE(j)                                                                   \
    {                                                                                  \
        uint hq = hq0 + j;                                                             \
        F32x4 o = F32x4(arg(3) + 4 * ((uint64_t(hq) * splits + block) * D + lane * 8)); \
        o.v[0] = aa##j;                                                                \
        o.v[1] = ab##j;                                                                \
        if (lane == 0) {                                                               \
            stats.v[(hq * splits + block) * 2] = m##j;                                 \
            stats.v[(hq * splits + block) * 2 + 1] = l##j;                             \
        }                                                                              \
    }

#define MLX_EACH2(M) M(0) M(1)

void main() {
    uint D = arg_u32(5), max_seq = arg_u32(6), len = arg_u32(7), splits = arg_u32(8), group = arg_u32(9);
    float scale = arg_f32(10);
    uvec2 tg = threadgroup_position_in_grid.xy;
    uint sg = simdgroup_index_in_threadgroup, lane = thread_index_in_simdgroup;
    F32 stats = F32(arg(4));

    uint kh = tg.x;
    uint block = tg.y;
    uint hq0 = kh * group + sg * 2;
    MLX_EACH2(MLX_DECL)
    // A head's rows by uint4: row p, dims 8 lane.. is at p * D / 8 + lane.
    U32x4 k_rows = U32x4(arg(1) + 2 * (uint64_t(kh) * max_seq * D));
    U32x4 v_rows = U32x4(arg(2) + 2 * (uint64_t(kh) * max_seq * D));
    for (uint p = block; p < len; p += 256) {
        uint p1 = p + 128;
        bool have1 = p1 < len;
        uvec4 kq0 = k_rows.v[p * (D / 8) + lane];
        uvec4 kq1 = k_rows.v[(have1 ? p1 : p) * (D / 8) + lane];
        vec4 ka0 = bf4(kq0.xy);
        vec4 kb0 = bf4(kq0.zw);
        vec4 ka1 = bf4(kq1.xy);
        vec4 kb1 = bf4(kq1.zw);
        MLX_EACH2(MLX_SCORE2)
        uvec4 vq0 = v_rows.v[p * (D / 8) + lane];
        uvec4 vq1 = v_rows.v[(have1 ? p1 : p) * (D / 8) + lane];
        vec4 va0 = bf4(vq0.xy);
        vec4 vb0 = bf4(vq0.zw);
        vec4 va1 = bf4(vq1.xy);
        vec4 vb1 = bf4(vq1.zw);
        MLX_EACH2(MLX_ACC2)
    }
    MLX_EACH2(MLX_STORE)
}
#endif

#ifdef KERNEL_sdpa_decode_combine
// Combine split statistics without per-split scratch.
shared float m_max;
shared float inv_l;
void main() {
    uint D = arg_u32(3), splits = arg_u32(4);
    uint hq = threadgroup_position_in_grid.x, tid = thread_index_in_threadgroup;
    F32 stats = F32(arg(1));

    if (tid == 0) {
        float m = NEG_INFINITY;
        for (uint s = 0; s < splits; ++s) m = max(m, stats.v[(hq * splits + s) * 2]);
        float l = 0.0;
        for (uint s = 0; s < splits; ++s) {
            float w = stats.v[(hq * splits + s) * 2 + 1] * exp(stats.v[(hq * splits + s) * 2] - m);
            l += w;
        }
        m_max = m;
        inv_l = 1.0 / l;
    }
    barrier();

    float m = m_max;
    // Split s of the head, element d: partials.v[s * D + d].
    F32 partials = F32(arg(0) + 4 * (uint64_t(hq) * splits * D));
    for (uint d = tid; d < D; d += TG) {
        float acc = 0.0;
        for (uint s = 0; s < splits; ++s) {
            acc += exp(stats.v[(hq * splits + s) * 2] - m) * partials.v[s * D + d];
        }
        BF16(arg(2)).v[hq * D + d] = bfloat16_t(acc * inv_l);
    }
}
#endif
