#ifdef KERNEL_k_norm_rope_scatter_decode_q8
shared bfloat16_t roped[256];
void main() {
    uint D = arg_u32(4), rot = arg_u32(5), pos = arg_u32(6);
    float theta = arg_f32(7), eps = arg_f32(8);
    uint max_seq = arg_u32(9);
    int rope_delta = arg_i32(10);
    uint head = threadgroup_position_in_grid.x, tid = thread_index_in_threadgroup;
    BF16 k = BF16(arg(0) + 2 * (uint64_t(head) * D));
    uint64_t row = uint64_t(head) * max_seq + pos;
    prep_norm(float(k.v[tid]), BF16(arg(1)), D, eps);
#define ROPED_AT(i) roped[i]
    PREP_ROPE(ROPED_AT)
    barrier();
    uint scale;
    I8(arg(2) + row * D).v[tid] = kv_q8(float(roped[tid]), scale);
    if (thread_index_in_simdgroup == 0) {
