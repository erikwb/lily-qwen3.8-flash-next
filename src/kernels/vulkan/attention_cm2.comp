#version 460
// The dense prefill attention tile of attention.comp
// (sdpa_prefill_nax_qdev128) with the scores kept in registers, on the
// cooperative-matrix operations of GL_NV_cooperative_matrix2: row
// reductions (max, sum), per-element functions (scale, causal mask, exp) and
// the conversion of an accumulator into an A operand. Same arguments and
// geometry (sdpa_prefill_with): a threadgroup of four subgroups takes
// FA_BQ = 16 query rows of one head.
//
// sdpa_prefill_cm2: the shipped kernel's split and operand loads (subgroup
// s computes the tile's key blocks 2s and 2s + 1, and P V for the head dims
// 64s .. 64s + 63 over all eight), with the softmax on the scores where the
// matrix units leave them. Each subgroup reduces its own blocks' rows; the
// four exchange 16 row maxima and 16 row sums through threadgroup memory
// (a lane reads the four subgroups' values of its two rows as two vectors);
// the probabilities become A operands in registers and each lane stores its
// own elements of them, in the order the P V loads read. No score tile goes
// through threadgroup memory, and the buffers alternate between key tiles,
// so a tile has two barriers.
//
// sdpa_prefill_cm2_split: from Q K^T through the softmax into P V without
// threadgroup memory. A block of scores can feed P V only in the subgroup
// that computed it, so a subgroup computes whole rows of scores (all 256
// head dims) and multiplies them into half the head dims (an accumulator of
// all 256 is 16 matrices, 128 registers, all a lane has): subgroup s takes
// the half h = s & 1 and the 32-key steps 2j + (s >> 1), two blocks at a
// time. The two subgroups of a half each run the online softmax over their
// own keys and combine their maxima, sums and accumulators once at the end.
// Operands are loaded as sdpa_prefill_cm2 loads them; each score block is
// computed twice (once per half).
//
// What it gains (sdpa_prefill_cm2_timing, one layer of 24 heads, best of
// five interleaved rounds, three runs, 2026-11-10): sdpa_prefill_cm2 takes
// 0.96 to 0.99 of the shipped kernel's time (121-123 us against 126-129 at
// three rows over 1 100 positions, 915-923 against 935-944 at 512 rows over
// 2 048), sdpa_prefill_cm2_split 1.37 to 1.52 of it. The softmax is a tenth
// of a key tile's instructions in either kernel (the compiled in-register
// one, its maxima, sums, masks, exponentials and the conversion to A
// operands, is 400 instructions, the shipped one's 340); a tile's time is
// its chain of sixteen Q K^T steps and eight P V steps, each waiting for its
// loads, which neither form of the softmax shortens. sdpa_prefill_cm2_split
// doubles the Q K^T steps a subgroup runs.
#include "common.glsl"
#include "matmul.glsl"
#extension GL_NV_cooperative_matrix2 : require

#if defined(KERNEL_sdpa_prefill_cm2) || defined(KERNEL_sdpa_prefill_cm2_split)
#define NEG_INFINITY (-1.0 / 0.0)
const uint FA_D = 256, FA_BQ = 16, FA_SG = 4;

float max_of(const in float a, const in float b) { return max(a, b); }
float sum_of(const in float a, const in float b) { return a + b; }

// The scaled score of the block's key `col` for its query `row`: -inf past
// the row's causal end (`lim0 + row` keys of the block) or past the keys.
float masked(const in uint row, const in uint col, const in float s, const in int lim0,
             const in int keys, const in float scale) {
    return int(col) < min(lim0 + int(row), keys) ? s * scale : NEG_INFINITY;
}
float larger(const in uint row, const in uint col, const in float a, const in float b) {
    return max(a, b);
}
// exp(s - m); 0 for a masked score (m is -inf only if every score of the
// row so far is).
float exp_less(const in uint row, const in uint col, const in float s, const in float m) {
    return s == NEG_INFINITY ? 0.0 : exp(s - m);
}
// The factor of a running sum whose maximum moves from `prev` to `next`.
float rescale(const in uint row, const in uint col, const in float prev, const in float next) {
    return prev == NEG_INFINITY ? 0.0 : exp(prev - next);
}

// A matrix whose elements in a lane's first row (elements 0..3) are `r0`
// and in its second (4..7) `r1`.
MatC by_row(float r0, float r1) {
    MatC m;
    for (uint e = 0; e < 8; ++e) m[e] = e < 4 ? r0 : r1;
    return m;
}
#endif

#ifdef KERNEL_sdpa_prefill_cm2
const uint FA_BK = 128;

// The probabilities of the two key-tile parities (attention.comp's p_tile:
// vector ((16 b + row) * 4 + 2 half + odd) holds keys 8 half + odd + 2 j,
// j in 0..4, of key block b), and each subgroup's row maxima and row sums of
// its blocks: vector (16 parity + row), component subgroup, so a lane reads
// the four subgroups' values of its two rows in two loads.
shared bf16vec4 p_tile[2 * FA_BQ * FA_BK / 4];
shared vec4 sg_max[2 * FA_BQ], sg_sum[2 * FA_BQ];
// The query tile in the lanes' order: vector 32 t + lane holds a lane's eight
// elements of the operand of head dims 16 t .. 16 t + 15.
shared uvec4 q_tile[FA_D / 16 * 32];

// attention.comp's FA_SCORES, FA_VALUE_LOAD, FA_VALUE_STEP, FA_SCALE and
// FA_STORE; FA_VALUES reads the tile's half of p_tile.
#define FA_SCORES(pair)                                                                       \
    for (uint t = 0; t < FA_D / 16; ++t) {                                                    \
        uint d0 = 16 * t;                                                                     \
        uvec4 k0w = uvec4(pair(k_head, k_at0.x + d0), pair(k_head, k_at0.y + d0),             \
                          pair(k_head, k_at0.z + d0), pair(k_head, k_at0.w + d0));            \
        uvec4 k1w = uvec4(pair(k_head, k_at1.x + d0), pair(k_head, k_at1.y + d0),             \
                          pair(k_head, k_at1.z + d0), pair(k_head, k_at1.w + d0));            \
        uvec4 qw = q_tile[gl_SubgroupInvocationID + 32 * t];                                  \
        MatA mq;                                                                              \
        MatB mk;                                                                              \
        MAT_OF_WORDS(mq, qw)                                                                  \
        MAT_B_OF_PAIRS(mk, k0w.x, k0w.y, k0w.z, k0w.w)                                        \
        s_acc[0] = coopMatMulAdd(mq, mk, s_acc[0]);                                           \
        MAT_B_OF_PAIRS(mk, k1w.x, k1w.y, k1w.z, k1w.w)                                        \
        s_acc[1] = coopMatMulAdd(mq, mk, s_acc[1]);                                           \
    }
#define FA_VALUE_LOAD(half, i) uvec2 v0w##i = half(v_head, v_at.x + 16 * i), v1w##i = half(v_head, v_at.y + 16 * i);
#define FA_VALUE_STEP(i)                                                                      \
    MAT_B_OF_ROWS(mv, v0w##i, v1w##i)                                                         \
    acc##i = coopMatMulAdd(mp, mv, acc##i);
#define FA_VALUES(half)                                                                       \
    for (uint b = 0; b < FA_BK / 16; ++b) {                                                   \
        int key0 = k0 + 16 * int(b);                                                          \
        if (key0 >= k_end) break;                                                             \
        uvec2 v_at = min(uvec2(key0) + uvec2(lane_row, lane_row + 1), uvec2(last_key)) * FA_D + (64 * sg + lane_col); \
        FA_VALUE_LOAD(half, 0) FA_VALUE_LOAD(half, 1) FA_VALUE_LOAD(half, 2) FA_VALUE_LOAD(half, 3) \
        bf16vec4 p0w = p_tile[p_base + p_at + 64 * b], p1w = p_tile[p_base + p_at + 64 * b + 4]; \
        MatA mp;                                                                              \
        MatB mv;                                                                              \
        MAT_A_OF_ELEMENTS(mp, p0w, p1w)                                                       \
        FA_VALUE_STEP(0) FA_VALUE_STEP(1) FA_VALUE_STEP(2) FA_VALUE_STEP(3)                   \
    }
#define FA_SCALE(i) acc##i = acc##i * alpha;
#define FA_STORE(i)                                                                           \
    for (uint h = 0; h < 2; ++h) {                                                            \
        uint row = uint(q0) + lane_row + h;                                                   \
        if (row < M) {                                                                        \
            vec4 o = vec4(acc##i[4 * h], acc##i[4 * h + 1], acc##i[4 * h + 2], acc##i[4 * h + 3]) / \
                     (h == 0 ? sum0 : sum1);                                                  \
            uint64_t o_row = arg(3) + 2 * (uint64_t(row * nq + hq) * FA_D);                   \
            if (wide_out) {                                                                   \
                MAT_STORE_HALF(o_row, 64 * sg + 16 * i + lane_col, o);                        \
            } else {                                                                          \
                MAT_STORE_HALF_UNALIGNED(o_row, 64 * sg + 16 * i + lane_col, o);              \
            }                                                                                 \
        }                                                                                     \
    }

void main() {
    uint max_seq = arg_u32(4), base_len = arg_u32(5), M = arg_u32(6), nq = arg_u32(7), group = arg_u32(8);
    float scale = arg_f32(9);
    uint tid = gl_LocalInvocationIndex, sg = gl_SubgroupID;
    int q0 = int(gl_WorkGroupID.x) * int(FA_BQ);
    uint hq = gl_WorkGroupID.y;
    int len_total = int(base_len) + int(M);
    if (gl_WorkGroupSize.x != 32 * FA_SG) return;

    uint64_t k_head = arg(1) + 2 * (uint64_t(hq / group) * max_seq * FA_D);
    uint64_t v_head = arg(2) + 2 * (uint64_t(hq / group) * max_seq * FA_D);
    uint64_t q_rows = arg(0) + 2 * (uint64_t(uint(q0) * nq + hq) * FA_D);
    uint q_stride = nq * FA_D;
    uint q_valid = min(FA_BQ, M - uint(q0));
    bool wide = ((arg(0) | arg(1) | arg(2)) & 3) == 0, wide_out = (arg(3) & 3) == 0;

    // The query tile, once (attention.comp).
    {
        uint t = tid / 8;
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            uint lane = 4 * (tid % 8) + j;
            uint row = (lane & 6) | ((lane >> 1) & 8);
            uint d = 16 * t + 8 * (lane & 1), odd16 = 16 * ((lane >> 3) & 1);
            uint at0 = min(row, q_valid - 1) * q_stride + d, at1 = min(row + 1, q_valid - 1) * q_stride + d;
            uvec4 w0, w1;
            if (wide) {
                w0 = MAT_VECTOR(q_rows, at0);
                w1 = MAT_VECTOR(q_rows, at1);
            } else {
                w0 = MAT_VECTOR_UNALIGNED(q_rows, at0);
                w1 = MAT_VECTOR_UNALIGNED(q_rows, at1);
            }
            w0 = (w0 >> odd16) & 0xFFFFu;
            w1 = (w1 >> odd16) & 0xFFFFu;
            q_tile[32 * t + lane] = uvec4(w0.x | (w0.y << 16), w0.z | (w0.w << 16), w1.x | (w1.y << 16), w1.z | (w1.w << 16));
        }
    }
    barrier();

    uint lane_row = mat_lane_row(), lane_col = mat_lane_col();
    uint p_at = lane_row * 4 + 2 * mat_a_half() + mat_a_odd();
    uint last_key = uint(len_total) - 1;
    // The lane's two rows' running maximum and sum.
    float m0 = NEG_INFINITY, m1 = NEG_INFINITY, sum0 = 0.0, sum1 = 0.0;

    MatC acc0 = MatC(0.0), acc1 = MatC(0.0), acc2 = MatC(0.0), acc3 = MatC(0.0);

    int k_end = min(len_total, int(base_len) + q0 + int(FA_BQ));
    uint parity = 0;
    for (int k0 = 0; k0 < k_end; k0 += int(FA_BK), parity ^= 1u) {
        uint p_base = parity * (FA_BQ * FA_BK / 4), s_base = parity * FA_BQ + lane_row;
        // S = Q K^T for the subgroup's two blocks.
        int key_s = k0 + 32 * int(sg);
        int blocks = key_s >= k_end ? 0 : key_s + 16 < k_end ? 2 : 1;
        MatC s_acc[2];
        s_acc[0] = MatC(0.0);
        s_acc[1] = MatC(0.0);
        if (blocks > 0) {
            uvec4 keys = uvec4(key_s) + lane_col + uvec4(0, 1, 2, 3);
            uvec4 k_at0 = min(keys, uvec4(last_key)) * FA_D + lane_row;
            uvec4 k_at1 = min(keys + 16, uvec4(last_key)) * FA_D + lane_row;
            if (wide) {
                FA_SCORES(MAT_PAIR)
            } else {
                FA_SCORES(MAT_PAIR_UNALIGNED)
            }
        }

        // Scaled and masked; the subgroup's row maxima, then the tile's.
        MatC m_sg = MatC(NEG_INFINITY);
        [[unroll]] for (int b = 0; b < 2; ++b) {
            int key0 = key_s + 16 * b;
            int lim0 = b < blocks ? int(base_len) + q0 + 1 - key0 : 0;
            int keys = b < blocks ? min(16, len_total - key0) : 0;
            if (lim0 >= 16 && keys == 16) {
                s_acc[b] = s_acc[b] * scale;
            } else {
                coopMatPerElementNV(s_acc[b], s_acc[b], masked, lim0, keys, scale);
            }
            MatC m_block;
            coopMatReduceNV(m_block, s_acc[b], gl_CooperativeMatrixReduceRowNV, max_of);
            coopMatPerElementNV(m_sg, m_sg, larger, m_block);
        }
        sg_max[s_base][sg] = m_sg[0];
        sg_max[s_base + 1][sg] = m_sg[4];
        barrier();
        vec4 x0 = sg_max[s_base], x1 = sg_max[s_base + 1];
        float n0 = max(max(max(m0, x0.x), max(x0.y, x0.z)), x0.w);
        float n1 = max(max(max(m1, x1.x), max(x1.y, x1.z)), x1.w);
        float alpha0 = m0 == NEG_INFINITY ? 0.0 : exp(m0 - n0);
        float alpha1 = m1 == NEG_INFINITY ? 0.0 : exp(m1 - n1);
        m0 = n0;
        m1 = n1;

        // P = exp(S - max): its row sums, and its A operands into p_tile.
        MatC m_tile = by_row(n0, n1), p_sum = MatC(0.0);
        [[unroll]] for (int b = 0; b < 2; ++b) {
            if (b >= blocks) break;
            coopMatPerElementNV(s_acc[b], s_acc[b], exp_less, m_tile);
            MatC block_sum;
            coopMatReduceNV(block_sum, s_acc[b], gl_CooperativeMatrixReduceRowNV, sum_of);
            p_sum = p_sum + block_sum;
            MatA p = MatA(s_acc[b]);
            uint at = p_base + p_at + 64 * (2 * sg + uint(b));
            p_tile[at] = bf16vec4(p[0], p[1], p[2], p[3]);
            p_tile[at + 4] = bf16vec4(p[4], p[5], p[6], p[7]);
        }
        sg_sum[s_base][sg] = p_sum[0];
        sg_sum[s_base + 1][sg] = p_sum[4];
        barrier();
        vec4 y0 = sg_sum[s_base], y1 = sg_sum[s_base + 1];
        float t0 = (y0.x + y0.y) + (y0.z + y0.w), t1 = (y1.x + y1.y) + (y1.z + y1.w);
        sum0 = sum0 * alpha0 + t0;
        sum1 = sum1 * alpha1 + t1;

        // acc = acc * alpha[row] + P V. The next tile writes the other half
        // of p_tile, sg_max and sg_sum, and this half only after the next
        // tile's first barrier, which every subgroup reaches after this.
        MatC alpha = by_row(alpha0, alpha1);
        FA_SCALE(0) FA_SCALE(1) FA_SCALE(2) FA_SCALE(3)
        if (wide) {
            FA_VALUES(MAT_HALF)
        } else {
            FA_VALUES(MAT_HALF_UNALIGNED)
        }
    }

    FA_STORE(0) FA_STORE(1) FA_STORE(2) FA_STORE(3)
}
#endif

#ifdef KERNEL_sdpa_prefill_cm2_split
const uint FA_HALF = FA_D / 2;
// The query tile in the lanes' order (sdpa_prefill_cm2).
shared uvec4 q_tile[FA_D / 16 * 32];
// Per half: the second key subgroup's accumulators, and its running maxima
// and sums of the tile's rows.
const uint PARTNER = FA_HALF / 16 * 256;
shared float partner[2 * PARTNER];
shared float partner_m[2 * FA_BQ], partner_l[2 * FA_BQ];

// S = Q K^T over all the head dims for the subgroup's two key blocks
// (sdpa_prefill_cm2's FA_SCORES).
#define SPLIT_SCORES(pair)                                                                    \
    for (uint t = 0; t < FA_D / 16; ++t) {                                                    \
        uint d0 = 16 * t;                                                                     \
        uvec4 k0w = uvec4(pair(k_head, k_at0.x + d0), pair(k_head, k_at0.y + d0),             \
                          pair(k_head, k_at0.z + d0), pair(k_head, k_at0.w + d0));            \
        uvec4 k1w = uvec4(pair(k_head, k_at1.x + d0), pair(k_head, k_at1.y + d0),             \
                          pair(k_head, k_at1.z + d0), pair(k_head, k_at1.w + d0));            \
        uvec4 qw = q_tile[gl_SubgroupInvocationID + 32 * t];                                  \
        MatA mq;                                                                              \
        MatB mk;                                                                              \
        MAT_OF_WORDS(mq, qw)                                                                  \
        MAT_B_OF_PAIRS(mk, k0w.x, k0w.y, k0w.z, k0w.w)                                        \
        s_acc[0] = coopMatMulAdd(mq, mk, s_acc[0]);                                           \
        MAT_B_OF_PAIRS(mk, k1w.x, k1w.y, k1w.z, k1w.w)                                        \
        s_acc[1] = coopMatMulAdd(mq, mk, s_acc[1]);                                           \
    }
// acc[4 g + i] += P V for key block b (its probabilities the A operand p)
// and the half's head-dim blocks 4 g + i: a step's eight loads before its
// four multiplies.
#define SPLIT_VALUE_LOAD(half, i) uvec2 v0w##i = half(v_head, v_at.x + 16 * i), v1w##i = half(v_head, v_at.y + 16 * i);
#define SPLIT_VALUE_STEP(g, i, p)                                                              \
    MAT_B_OF_ROWS(mv, v0w##i, v1w##i)                                                         \
    acc[4 * g + i] = coopMatMulAdd(p, mv, acc[4 * g + i]);
#define SPLIT_VALUE_GROUP(half, g, p)                                                          \
    {                                                                                         \
        uvec2 v_at = keys_at + (FA_HALF * half_d + 64 * g + lane_col);                        \
        SPLIT_VALUE_LOAD(half, 0) SPLIT_VALUE_LOAD(half, 1) SPLIT_VALUE_LOAD(half, 2) SPLIT_VALUE_LOAD(half, 3) \
        MatB mv;                                                                              \
        SPLIT_VALUE_STEP(g, 0, p) SPLIT_VALUE_STEP(g, 1, p) SPLIT_VALUE_STEP(g, 2, p) SPLIT_VALUE_STEP(g, 3, p) \
    }
#define SPLIT_VALUES(half, b, p)                                                              \
    {                                                                                         \
        uvec2 keys_at = min(uvec2(key_s + 16 * b) + uvec2(lane_row, lane_row + 1), uvec2(last_key)) * FA_D; \
        SPLIT_VALUE_GROUP(half, 0, p) SPLIT_VALUE_GROUP(half, 1, p)                               \
    }

void main() {
    uint max_seq = arg_u32(4), base_len = arg_u32(5), M = arg_u32(6), nq = arg_u32(7), group = arg_u32(8);
    float scale = arg_f32(9);
    uint tid = gl_LocalInvocationIndex, sg = gl_SubgroupID, half_d = sg & 1u, part = sg >> 1;
    int q0 = int(gl_WorkGroupID.x) * int(FA_BQ);
    uint hq = gl_WorkGroupID.y;
    int len_total = int(base_len) + int(M);
    if (gl_WorkGroupSize.x != 32 * FA_SG) return;

    uint64_t k_head = arg(1) + 2 * (uint64_t(hq / group) * max_seq * FA_D);
    uint64_t v_head = arg(2) + 2 * (uint64_t(hq / group) * max_seq * FA_D);
    uint64_t q_rows = arg(0) + 2 * (uint64_t(uint(q0) * nq + hq) * FA_D);
    uint q_stride = nq * FA_D;
    uint q_valid = min(FA_BQ, M - uint(q0));
    bool wide = ((arg(0) | arg(1) | arg(2)) & 3) == 0, wide_out = (arg(3) & 3) == 0;

    // The query tile, once (attention.comp).
    {
        uint t = tid / 8;
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            uint lane = 4 * (tid % 8) + j;
            uint row = (lane & 6) | ((lane >> 1) & 8);
            uint d = 16 * t + 8 * (lane & 1), odd16 = 16 * ((lane >> 3) & 1);
            uint at0 = min(row, q_valid - 1) * q_stride + d, at1 = min(row + 1, q_valid - 1) * q_stride + d;
            uvec4 w0, w1;
            if (wide) {
                w0 = MAT_VECTOR(q_rows, at0);
                w1 = MAT_VECTOR(q_rows, at1);
            } else {
                w0 = MAT_VECTOR_UNALIGNED(q_rows, at0);
                w1 = MAT_VECTOR_UNALIGNED(q_rows, at1);
            }
            w0 = (w0 >> odd16) & 0xFFFFu;
            w1 = (w1 >> odd16) & 0xFFFFu;
            q_tile[32 * t + lane] = uvec4(w0.x | (w0.y << 16), w0.z | (w0.w << 16), w1.x | (w1.y << 16), w1.z | (w1.w << 16));
        }
    }
    barrier();

    uint lane_row = mat_lane_row(), lane_col = mat_lane_col();
    uint last_key = uint(len_total) - 1;
    // The lane's two rows' running maximum and sum.
    float m0 = NEG_INFINITY, m1 = NEG_INFINITY, l0 = 0.0, l1 = 0.0;
    MatC acc[FA_HALF / 16];
    for (uint i = 0; i < FA_HALF / 16; ++i) acc[i] = MatC(0.0);

    int k_end = min(len_total, int(base_len) + q0 + int(FA_BQ));
    for (int key_s = 32 * int(part); key_s < k_end; key_s += 64) {
        int blocks = key_s + 16 < k_end ? 2 : 1;
        MatC s_acc[2];
        s_acc[0] = MatC(0.0);
        s_acc[1] = MatC(0.0);
        // The lane's four keys of each block (a key past the cache's rows
        // reads the last: its score is masked), at its two rows of the head
        // dim.
        uvec4 keys = uvec4(key_s) + lane_col + uvec4(0, 1, 2, 3);
        uvec4 k_at0 = min(keys, uvec4(last_key)) * FA_D + lane_row;
        uvec4 k_at1 = min(keys + 16, uvec4(last_key)) * FA_D + lane_row;
        if (wide) {
            SPLIT_SCORES(MAT_PAIR)
        } else {
            SPLIT_SCORES(MAT_PAIR_UNALIGNED)
        }

        // Scaled and masked; the rows' maxima over the two blocks.
        float n0 = m0, n1 = m1;
        [[unroll]] for (int b = 0; b < 2; ++b) {
            int key0 = key_s + 16 * b;
            int lim0 = b < blocks ? int(base_len) + q0 + 1 - key0 : 0;
            int keys_left = b < blocks ? min(16, len_total - key0) : 0;
            if (lim0 >= 16 && keys_left == 16) {
                s_acc[b] = s_acc[b] * scale;
            } else {
                coopMatPerElementNV(s_acc[b], s_acc[b], masked, lim0, keys_left, scale);
            }
            MatC m_block;
            coopMatReduceNV(m_block, s_acc[b], gl_CooperativeMatrixReduceRowNV, max_of);
            n0 = max(n0, m_block[0]);
            n1 = max(n1, m_block[4]);
        }
        float alpha0 = m0 == NEG_INFINITY ? 0.0 : exp(m0 - n0);
        float alpha1 = m1 == NEG_INFINITY ? 0.0 : exp(m1 - n1);
        m0 = n0;
        m1 = n1;

        // P = exp(S - max) as A operands, in registers; its row sums.
        MatC m_tile = by_row(n0, n1);
        float t0 = 0.0, t1 = 0.0;
        [[unroll]] for (int b = 0; b < 2; ++b) {
            coopMatPerElementNV(s_acc[b], s_acc[b], exp_less, m_tile);
            MatC block_sum;
            coopMatReduceNV(block_sum, s_acc[b], gl_CooperativeMatrixReduceRowNV, sum_of);
            t0 += block_sum[0];
            t1 += block_sum[4];
        }
        MatA p0 = MatA(s_acc[0]), p1 = MatA(s_acc[1]);
        l0 = l0 * alpha0 + t0;
        l1 = l1 * alpha1 + t1;

        MatC alpha = by_row(alpha0, alpha1);
        for (uint i = 0; i < FA_HALF / 16; ++i) acc[i] = acc[i] * alpha;
        if (wide) {
            SPLIT_VALUES(MAT_HALF, 0, p0)
            if (blocks > 1) SPLIT_VALUES(MAT_HALF, 1, p1)
        } else {
            SPLIT_VALUES(MAT_HALF_UNALIGNED, 0, p0)
            if (blocks > 1) SPLIT_VALUES(MAT_HALF_UNALIGNED, 1, p1)
        }
    }

    // The second key subgroup of each half hands its state to the first.
    uint at = PARTNER * half_d;
    if (part == 1u) {
        for (uint i = 0; i < FA_HALF / 16; ++i)
            coopMatStore(acc[i], partner, at + 256 * i, 16, gl_CooperativeMatrixLayoutRowMajor);
        partner_m[FA_BQ * half_d + lane_row] = m0;
        partner_m[FA_BQ * half_d + lane_row + 1] = m1;
        partner_l[FA_BQ * half_d + lane_row] = l0;
        partner_l[FA_BQ * half_d + lane_row + 1] = l1;
    }
    barrier();
    if (part != 0u) return;

    float o_m0 = partner_m[FA_BQ * half_d + lane_row], o_m1 = partner_m[FA_BQ * half_d + lane_row + 1];
    float o_l0 = partner_l[FA_BQ * half_d + lane_row], o_l1 = partner_l[FA_BQ * half_d + lane_row + 1];
    float all0 = max(m0, o_m0), all1 = max(m1, o_m1);
    float a0 = rescale(0u, 0u, m0, all0), a1 = rescale(0u, 0u, m1, all1);
    float b0 = rescale(0u, 0u, o_m0, all0), b1 = rescale(0u, 0u, o_m1, all1);
    float inv0 = 1.0 / (l0 * a0 + o_l0 * b0), inv1 = 1.0 / (l1 * a1 + o_l1 * b1);
    MatC mine = by_row(a0 * inv0, a1 * inv1), theirs = by_row(b0 * inv0, b1 * inv1);
    for (uint i = 0; i < FA_HALF / 16; ++i) {
        MatC other;
        coopMatLoad(other, partner, at + 256 * i, 16, gl_CooperativeMatrixLayoutRowMajor);
        MatC o = acc[i] * mine + other * theirs;
        for (uint h = 0; h < 2; ++h) {
            uint row = uint(q0) + lane_row + h;
            if (row < M) {
                vec4 v = vec4(o[4 * h], o[4 * h + 1], o[4 * h + 2], o[4 * h + 3]);
                uint64_t o_row = arg(3) + 2 * (uint64_t(row * nq + hq) * FA_D);
                uint col = FA_HALF * half_d + 16 * i + lane_col;
                if (wide_out) {
                    MAT_STORE_HALF(o_row, col, v);
                } else {
                    MAT_STORE_HALF_UNALIGNED(o_row, col, v);
                }
            }
        }
    }
}
#endif
