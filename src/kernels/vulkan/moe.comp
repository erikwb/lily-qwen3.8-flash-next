// Scans slot and row-tile offsets; T must match the grouped GEMM tile height.
#ifdef KERNEL_moe_scan_offsets
#define MOE_SCAN_THREADS 256
shared uint sg_rows[MOE_SCAN_THREADS / 32];
shared uint sg_tiles[MOE_SCAN_THREADS / 32];
void main() {
    U32 counts = U32(arg(0)), offsets = U32(arg(1)), tile_offsets = U32(arg(2));
    uint E = arg_u32(3), T = arg_u32(4);
    uint lane = thread_index_in_simdgroup, sg = simdgroup_index_in_threadgroup;
    // A thread's run of experts is numbered by its place in the scan (Metal:
    // the thread index, which is that place there).
    uint tid = sg * 32 + lane;
    uint per = (E + MOE_SCAN_THREADS - 1) / MOE_SCAN_THREADS;
    uint e0 = min(tid * per, E), e1 = min(e0 + per, E);
    uint rows = 0, tiles = 0;
    for (uint e = e0; e < e1; ++e) {
        rows += counts.v[e];
        tiles += (counts.v[e] + T - 1) / T;
    }
    uint rows_before = subgroupExclusiveAdd(rows);
    uint tiles_before = subgroupExclusiveAdd(tiles);
    if (lane == 31) {
        sg_rows[sg] = rows_before + rows;
        sg_tiles[sg] = tiles_before + tiles;
    }
    barrier();
    for (uint g = 0; g < sg; ++g) {
        rows_before += sg_rows[g];
        tiles_before += sg_tiles[g];
    }
    uint acc = rows_before, tacc = tiles_before;
    for (uint e = e0; e < e1; ++e) {
        offsets.v[e] = acc;
        tile_offsets.v[e] = tacc;
        acc += counts.v[e];
        tacc += (counts.v[e] + T - 1) / T;
    }
    if (tid == MOE_SCAN_THREADS - 1) {
        offsets.v[E] = acc;
        tile_offsets.v[E] = tacc;
    }
}
#endif

// Scatters slots into expert-major order; within-expert order is unspecified.
#ifdef KERNEL_moe_scatter_slots
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    uint K = arg_u32(5), S = arg_u32(6), i = thread_position_in_grid.x;
    if (i >= S) return;
    uint e = U32(arg(0)).v[i];
    uint pos = atomicAdd(U32(arg(2)).v[e], 1u);
    uint slot = U32(arg(1)).v[e] + pos;
    U32(arg(3)).v[slot] = i / K;
    U32(arg(4)).v[i] = slot;
}
#endif

// Builds grouped-GEMM blocks; T must match the offset scan.
#ifdef KERNEL_moe_build_blocks
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    U32 offsets = U32(arg(0)), tile_offsets = U32(arg(1));
    uint E = arg_u32(4), N_PER = arg_u32(5), T = arg_u32(6), ORDER = arg_u32(7), REMAP = arg_u32(8);
    uint t = thread_position_in_grid.x, n_tile = thread_position_in_grid.y;
    uint n_tiles = N_PER / 64;
    uint total = tile_offsets.v[E];
    uint64_t at = uint64_t(t) * n_tiles + n_tile;
    if (t >= total) {
        U32x4(arg(2) + 16 * at).v[0] = uvec4(0);
        return;
    }
    // Find the expert containing tile t.
    uint lo = 0, hi = E;
    while (lo + 1 < hi) {
        uint mid = (lo + hi) / 2;
        if (tile_offsets.v[mid] <= t) {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    uint e = lo;
    uint tile_in_e = t - tile_offsets.v[e];
    if (ORDER == 1) {
        uint expert_tiles = tile_offsets.v[e + 1] - tile_offsets.v[e];
        at = uint64_t(tile_offsets.v[e]) * n_tiles + uint64_t(n_tile) * expert_tiles + tile_in_e;
    }
    uint rows_of = e;
    if (REMAP != 0) rows_of = U32(arg(3)).v[e];
    U32x4(arg(2) + 16 * at).v[0] = uvec4(offsets.v[e] + tile_in_e * T, rows_of * N_PER + n_tile * 64, n_tile * 64, offsets.v[e + 1]);
}
#endif

// slots[i] = slot_of[indices[i]]: routed expert ids to expert-cache slots.
#ifdef KERNEL_moe_remap_slots
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    uint n = arg_u32(3), gid = thread_position_in_grid.x;
    if (gid < n) U32(arg(2)).v[gid] = U32(arg(1)).v[U32(arg(0)).v[gid]];
}
#endif
