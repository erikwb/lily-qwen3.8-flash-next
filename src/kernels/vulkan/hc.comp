// The Metal kernels run a subgroup per output column, lane i on block i of
// each stream's weight row: with R 320 that is 20 lanes of 32 at work, and
// every column's subgroup computes the activation's SiLU again. Instructions
// are what this kernel costs here (the direct port ran 2.2 M subgroup
// instructions a read, where the cores do about 0.28 M a microsecond:
// elementwise.rs, `level_shape_probe`, 2026-11-10), so the layout is one
// where all lanes work and nothing is computed twice:
// - A subgroup's eight quads are eight weight rows (the streams of 8 / GG
//   columns), and a quad's four lanes take the four blocks of one of the
//   row's quant-group-sized quarters of 64 codes a turn, R / 64 turns.
// - What a row's reduction adds is what the Metal kernel's subgroup sum
//   adds, in its order: the hardware sum is a tree over adjacent lanes
//   (`subgroup_sum_order_probe`), so its lanes 4j .. 4j+3 are the 4-lane
//   clustered sum of turn j, and the eight of those are added as the tree
//   adds them.
// - The activation is staged once per threadgroup (its first MB subgroups, a
//   row each) in threadgroup memory, where every turn reads it.
// - A row's scales and biases are 16 bytes each, loaded once.
// - The gate epilogue runs once per quad, its streams' gates and normalized
//   values brought to the column's lanes by broadcast.
// Given the same inputs the result is the direct port's bit for bit, for the
// single-row kernels; the MB-row kernels now equal the single-row kernel on
// every row, where the direct port's differed from it in the last bit of a
// few values in 100 000 (hc.rs tests, `up_layouts_agree_on_wide_data`).
// Measured in the chain (`hc_read_chain_timing`, `fused_batched_read_gate_
// timing`, us per read at H 2560, 4 streams, R 320, 2026-11-10): one row 17.5
// to 13.2 (Metal 7.7), three rows 31.0 to 15.0, four rows 40.8 to 18.2. What
// is left of the one-row kernel is its 3.3 MB of weights and a floor: with
// no weight load it takes 9.8, with no load at all 7.7.
// - Each turn and the scale-window choice inside it are branches, and on
//   this GPU every branch waits for all loads issued before it. With both
//   known at compile time (the `_r5w` kernels) the turns are straight-line
//   code: three rows 13.5 to 12.4 us a level, one row 11.6 to 10.8
//   (`hc_read_rows_chain_timing`, 2026-11-13; with `hc_turn_sum` below
//   both give the same bits). Loading every turn's codes
//   up front (17.3), reading the activation from device memory instead of
//   staging it (16.1), 4, 2 or 1 subgroups a threadgroup (15.9-18.3) and
//   staging the activation's sums (no change) all lost or tied.
#ifdef GG
#extension GL_KHR_shader_subgroup_clustered : require
#ifdef MB
#define UP_MB MB
#else
#define UP_MB 1
#define UP_SILU
#endif
#define UP_CPS (8 / GG)  // columns of a subgroup
#define UP_ACT 1024      // vec4s of staged activation (hc.rs: `HC_UP_ACT_MAX`)
shared vec4 up_act[UP_ACT];

// A turn's sum for one row: the quad lane's block of 16 codes (q0..q3, one
// word each) times the activation (x0..x3), with the scale s and bias bi
// of its quant group. Written out, in the order and with the fused
// multiply-adds the compiler gives `gemv_q8_bf16`'s block (quant.comp, its
// assembly read 2026-11-13), and `precise`, so that on the Honeykrisp build
// it was written against the read gate's logits are that GEMV's bit for bit
// in f32 (`up_mix_logits_are_the_gemv_bits` checks the single-row and
// three-row bodies). That is matched code generation, not a portable
// guarantee: glslc leaves `fma()` without NoContraction and the GEMV is left
// to fast math, so a compiler change on either side can break it; that test
// is what catches it. Left to fast math, the compiler ordered
// this sum differently in different instantiations: before 2026-11-13 the
// generic kernels' f32 logits already differed from the GEMV's (the bf16
// tests passed by rounding), and the `_r5w` kernels' straight-line turns
// came out with 18% of the logits different again and their single-row and
// rows kernels disagreeing (the tokens changed; every bf16 test passed).
float hc_dot_rev(vec4 q, vec4 x) {
    precise float d = q.w * x.w;
    d = fma(q.z, x.z, d);
    d = fma(q.y, x.y, d);
    d = fma(q.x, x.x, d);
    return d;
}
float hc_sum_rev(vec4 x) {
    precise float t = x.z + x.w;
    t = x.y + t;
    t = x.x + t;
    return t;
}
float hc_turn_sum(vec4 q0, vec4 q1, vec4 q2, vec4 q3, float s, float bi,
                  vec4 x0, vec4 x1, vec4 x2, vec4 x3) {
    precise float c = bi * hc_sum_rev(x1);
    c = fma(s, hc_dot_rev(q1, x1), c);
    c = fma(s, hc_dot_rev(q0, x0), c);
    c = fma(bi, hc_sum_rev(x0), c);
    c = fma(s, hc_dot_rev(q2, x2), c);
    c = fma(bi, hc_sum_rev(x2), c);
    c = fma(s, hc_dot_rev(q3, x3), c);
    c = fma(bi, hc_sum_rev(x3), c);
    // The GEMV adds the block to its zeroed accumulator.
    precise float a = 0.0 + c;
    return a;
}

void main() {
    // The params are one struct (hc.rs: `dispatch_read_up_mix`), two loads.
    uvec4 p0 = U32x4(arg(8)).v[0], p1 = U32x4(arg(8)).v[1];
    // bshift: log2 of the 16-code blocks per quant group; groups: per row.
    uint H = p0.x, R = p0.y, bshift = p0.z, groups = p0.w;
    float w_bias = uintBitsToFloat(p1.x);
    uint sg = simdgroup_index_in_threadgroup, lane = thread_index_in_simdgroup;
    uint quad = lane >> 2, p = lane & 3u;
    uint c = quad / GG, g = quad - c * GG;
    uint col = (threadgroup_position_in_grid.x * (threads_per_threadgroup.x / 32) + sg) * UP_CPS + c;
    bool live = c < UP_CPS && col < H;
    uint blocks = R >> 4, turns = R >> 6;
    uint K = GG * H;
    // A quad past the columns (or past 8 / GG whole columns) runs on row 0
    // and stores nothing: no branch on it in what follows.
    uint wrow = live ? g * H + col : 0u;

    // Subgroup m stages row m of the activation.
    if (sg < UP_MB) {
        for (uint i = lane; i < blocks; i += 32) {
            vec4 a[4];
            hc_load_block(arg(3), sg * blocks + i, a);
#ifdef UP_SILU
            [[unroll]] for (uint j = 0; j < 4; ++j) {
                vec4 v = a[j] * uintBitsToFloat(p1.y);
                a[j] = vec4(bf16_rne(v / (1.0 + exp(-v))));
            }
#endif
            [[unroll]] for (uint j = 0; j < 4; ++j) up_act[sg * (R >> 2) + 4 * i + j] = a[j];
        }
    }
    // Meanwhile a quad's lanes load what is its row's alone: the scales and
    // biases (up to seven groups fit a 16-byte window on a 4-byte boundary
    // that stays inside the tensor; more are loaded per turn) and the
    // normalized stream value of its column.
#ifdef UP_TURNS
    // Specialized kernels: R = 64 * UP_TURNS, at most seven groups a row.
    // The window is loaded after the barrier: without the branch, nothing
    // would use these loads before it, and a device load still in flight
    // when a workgroup barrier executes can return wrong data on this GPU.
    const bool window = true;
#else
    bool window = groups <= 7u;
#endif
    uvec4 sw = uvec4(0), bw = uvec4(0);
    uint sh = 0;
#ifndef UP_TURNS
    if (window) {
        uint e = wrow * groups;
        uint e0 = min(e & ~1u, K * groups - 8u);
        sh = e - e0;
        sw = U32x4(arg(1) + 2 * uint64_t(e0)).v[0];
        bw = U32x4(arg(2) + 2 * uint64_t(e0)).v[0];
    }
#endif
    float hn[UP_MB];
    float gain = w_bias + float(BF16(arg(5)).v[wrow]);
    [[unroll]] for (uint m = 0; m < UP_MB; ++m)
        hn[m] = float(bf16_rne(float(BF16(arg(4)).v[m * K + wrow]) * F32(arg(6)).v[m * GG + g] * gain));
    barrier();
#ifdef UP_TURNS
    {
        uint e = wrow * groups;
        uint e0 = min(e & ~1u, K * groups - 8u);
        sh = e - e0;
        sw = U32x4(arg(1) + 2 * uint64_t(e0)).v[0];
        bw = U32x4(arg(2) + 2 * uint64_t(e0)).v[0];
    }
#endif

    // Turn j: block 4j + p of the row (hc.rs keeps R to the eight turns of
    // one subgroup sum).
    U32x4 codes = U32x4(arg(0));
    uint co = wrow * blocks;
    float qs[8 * UP_MB];
    [[unroll]] for (uint j = 0; j < 8; ++j) {
        float a[UP_MB];
        [[unroll]] for (uint m = 0; m < UP_MB; ++m) a[m] = 0.0;
#ifdef UP_TURNS
        if (j < UP_TURNS) {
#else
        if (j < turns) {
#endif
            uint b = 4 * j + p;
            uvec4 w4 = codes.v[co + b];
            uint q = b >> bshift;
            float s, bi;
            if (window) {
                s = hc_half(sw, sh + q);
                bi = hc_half(bw, sh + q);
            } else {
                s = float(BF16(arg(1)).v[wrow * groups + q]);
                bi = float(BF16(arg(2)).v[wrow * groups + q]);
            }
            vec4 q0 = hc_unpack_q8(w4.x);
            vec4 q1 = hc_unpack_q8(w4.y);
            vec4 q2 = hc_unpack_q8(w4.z);
            vec4 q3 = hc_unpack_q8(w4.w);
            [[unroll]] for (uint m = 0; m < UP_MB; ++m) {
                uint at = m * (R >> 2) + 4 * b;
                a[m] = hc_turn_sum(q0, q1, q2, q3, s, bi, up_act[at], up_act[at + 1],
                                   up_act[at + 2], up_act[at + 3]);
            }
        }
        [[unroll]] for (uint m = 0; m < UP_MB; ++m) qs[j * UP_MB + m] = subgroupClusteredAdd(a[m], 4);
    }
    [[unroll]] for (uint m = 0; m < UP_MB; ++m) {
        precise float total = ((qs[m] + qs[UP_MB + m]) + (qs[2 * UP_MB + m] + qs[3 * UP_MB + m]))
            + ((qs[4 * UP_MB + m] + qs[5 * UP_MB + m]) + (qs[6 * UP_MB + m] + qs[7 * UP_MB + m]));
#ifdef UP_DEBUG_TOTAL
        if (live && p == 0u) F32(arg(7)).v[m * K + wrow] = total;
#endif
        float logit = float(bf16_rne(total));
        float gate = 1.0 / (1.0 + exp(-logit));
        // hc_mix_bf16 over the column's streams, whose quads' first lanes
        // are 4 * (c * GG + s).
        // hc_mix_bf16's sum, written out the same way (`precise`, fma).
        precise float acc = 0.0;
        [[unroll]] for (uint s = 0; s < GG; ++s) {
            float gv = 0.0, hv = 0.0;
            [[unroll]] for (uint cc = 0; cc < UP_CPS; ++cc) {
                gv = c == cc ? subgroupBroadcast(gate, 4 * (cc * GG + s)) : gv;
                hv = c == cc ? subgroupBroadcast(hn[m], 4 * (cc * GG + s)) : hv;
            }
            acc = fma(gv, hv, acc);
        }
#ifndef UP_DEBUG_TOTAL
        if (live && p == 0u && g == 0u) BF16(arg(7)).v[m * H + col] = bf16_rne(acc / float(GG));
#endif
    }
}
#endif
