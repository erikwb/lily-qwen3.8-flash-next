#ifdef GG
void main() {
    uint H = arg_u32(8), R = arg_u32(9), GS = arg_u32(10);
#ifdef MB
    float w_bias = arg_f32(11);
#else
    float inv_g = arg_f32(11), w_bias = arg_f32(12);
#endif
    uint col = threadgroup_position_in_grid.x * (threads_per_threadgroup.x / 32) + simdgroup_index_in_threadgroup;
    uint lane = thread_index_in_simdgroup;
    if (col >= H) return;  // whole subgroup
    uint words = R / 4;
    uint blocks = words / 4;
    uint bpg = GS / 16;
    uint groups = R / GS;
    // Each stream's weight row (g*H + col): where its uint4 blocks and its
    // scales/biases start, as 32-bit element offsets (Metal: 64-bit pointers
    // per stream; the weight is [G*H, R] and far below 2^32 blocks, and 64-bit
    // addresses per stream cost registers).
    U32x4 codes = U32x4(arg(0));
    BF16 scales = BF16(arg(1)), biases = BF16(arg(2));
    uint co[GG], so[GG];
    [[unroll]] for (uint g = 0; g < GG; ++g) {
        uint row = g * H + col;
        co[g] = row * blocks;
        so[g] = row * groups;
    }

    BF16 norm_w = BF16(arg(5));
    F32 inv_rms = F32(arg(6));
#ifndef MB
    // The gate epilogue's normalized stream values (hn) are loaded before the
    // weight loop (Metal loads them after the reduction), which takes 5-10%
    // off the kernel on this driver. (The MB-row kernels keep them after the
    // loop: GG * MB more live registers cost them more than it saves.)
    BF16 hyper = BF16(arg(4));
    float hn[GG];
    [[unroll]] for (uint g = 0; g < GG; ++g) {
        uint e = g * H + col;
        hn[g] = float(bf16_rne(float(hyper.v[e]) * inv_rms.v[g] * (w_bias + float(norm_w.v[e]))));
    }
    float sum[GG];
    [[unroll]] for (uint g = 0; g < GG; ++g) sum[g] = 0.0;
    HC_GROUP_INIT(lane, bpg)
    for (uint i = lane; i < blocks; i += 32) {
        uvec4 w4[GG];
        [[unroll]] for (uint g = 0; g < GG; ++g) w4[g] = codes.v[co[g] + i];
        vec4 act[4];
        hc_load_block(arg(3), i, act);
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            vec4 v = act[j] * inv_g;
            act[j] = vec4(bf16_rne(v / (1.0 + exp(-v))));
        }
        [[unroll]] for (uint g = 0; g < GG; ++g) {
            float s = float(scales.v[so[g] + q]);
            float b = float(biases.v[so[g] + q]);
            sum[g] += hc_dot_q8(hc_unpack_q8(w4[g].x), s, b, act[0])
                + hc_dot_q8(hc_unpack_q8(w4[g].y), s, b, act[1])
                + hc_dot_q8(hc_unpack_q8(w4[g].z), s, b, act[2])
                + hc_dot_q8(hc_unpack_q8(w4[g].w), s, b, act[3]);
        }
        HC_GROUP_NEXT(bpg)
    }
    float acc = 0.0;
    [[unroll]] for (uint g = 0; g < GG; ++g) {
        float logit = float(bf16_rne(subgroupAdd(sum[g])));
        float gate = 1.0 / (1.0 + exp(-logit));
        acc += gate * hn[g];
    }
    if (lane == 0) BF16(arg(7)).v[col] = bf16_rne(acc / float(GG));
#else
    uint K = GG * H;
    float sum[GG * MB];
    [[unroll]] for (uint e = 0; e < GG * MB; ++e) sum[e] = 0.0;
    HC_GROUP_INIT(lane, bpg)
    U32x4 actw = U32x4(arg(3));
    for (uint i = lane; i < blocks; i += 32) {
        // Every row's activation block, loaded once as words and widened per
        // stream (Metal reloads it per stream from L1; here each load
        // carries the driver's address translation).
        uvec4 araw[MB][2];
        [[unroll]] for (uint m = 0; m < MB; ++m) {
            araw[m][0] = actw.v[2 * (m * blocks + i)];
            araw[m][1] = actw.v[2 * (m * blocks + i) + 1];
        }
        [[unroll]] for (uint g = 0; g < GG; ++g) {
            uvec4 w4 = codes.v[co[g] + i];
            float s = float(scales.v[so[g] + q]);
            float b = float(biases.v[so[g] + q]);
            vec4 q0 = hc_unpack_q8(w4.x);
            vec4 q1 = hc_unpack_q8(w4.y);
            vec4 q2 = hc_unpack_q8(w4.z);
            vec4 q3 = hc_unpack_q8(w4.w);
            [[unroll]] for (uint m = 0; m < MB; ++m) {
                vec4 av[4];
                hc_widen_block(araw[m][0], araw[m][1], av);
                sum[g * MB + m] += hc_dot_q8(q0, s, b, av[0])
                    + hc_dot_q8(q1, s, b, av[1])
                    + hc_dot_q8(q2, s, b, av[2])
                    + hc_dot_q8(q3, s, b, av[3]);
            }
        }
        HC_GROUP_NEXT(bpg)
    }
    [[unroll]] for (uint m = 0; m < MB; ++m) {
        BF16 hyper_m = BF16(arg(4) + 2 * uint64_t(m) * K);
        float acc = 0.0;
        [[unroll]] for (uint g = 0; g < GG; ++g) {
            float logit = float(bf16_rne(subgroupAdd(sum[g * MB + m])));
            float gate = 1.0 / (1.0 + exp(-logit));
            uint e = g * H + col;
            float hn = float(bf16_rne(float(hyper_m.v[e]) * inv_rms.v[m * GG + g] * (w_bias + float(norm_w.v[e]))));
            acc += gate * hn;
        }
        if (lane == 0) BF16(arg(7) + 2 * uint64_t(m) * H).v[col] = bf16_rne(acc / float(GG));
    }
#endif
}
#endif
