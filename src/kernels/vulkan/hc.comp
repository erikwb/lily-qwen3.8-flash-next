#version 460
// The kernels of src/kernels/metal/hc.metal: hyper-connection (gated
// residual) kernels, the same arithmetic in the same order. The residual
// stream is G copies of the hidden width H laid out [rows, G*H].
#include "common.glsl"
#include "hc_common.glsl"

#define TG 256

#ifdef KERNEL_rmsnorm_grouped_bf16
shared float partial[TG / 32];
shared float inv_rms;
void main() {
    uint H = arg_u32(3), G = arg_u32(4);
    float eps = arg_f32(5), w_bias = arg_f32(6);
    uint seg = threadgroup_position_in_grid.x, tid = thread_index_in_threadgroup;
    uint sg = simdgroup_index_in_threadgroup, lane = thread_index_in_simdgroup;
    BF16 x = BF16(arg(0) + 2 * uint64_t(seg) * H), out_ = BF16(arg(2) + 2 * uint64_t(seg) * H);
    BF16 w = BF16(arg(1) + 2 * ((seg % G) * H));

    float acc = 0.0;
    for (uint i = tid; i < H; i += TG) {
        float v = float(x.v[i]);
        acc += v * v;
    }
    acc = subgroupAdd(acc);
    if (lane == 0) partial[sg] = acc;
    barrier();
    if (tid == 0) {
        float total = 0.0;
        for (uint i = 0; i < TG / 32; ++i) total += partial[i];
        inv_rms = inversesqrt(total / float(H) + eps);
    }
    barrier();
    for (uint i = tid; i < H; i += TG) {
        float gain = w_bias + float(w.v[i]);
        out_.v[i] = bf16_rne(float(x.v[i]) * inv_rms * gain);
    }
}
#endif

#ifdef KERNEL_silu_scaled_bf16
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    uint gid = thread_position_in_grid.x;
    float v = float(BF16(arg(0)).v[gid]) * arg_f32(2);
    BF16(arg(1)).v[gid] = bf16_rne(v / (1.0 + exp(-v)));
}
#endif

#ifdef KERNEL_hc_mix_bf16
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    uint H = arg_u32(3), G = arg_u32(4);
    uint i = thread_position_in_grid.x, r = thread_position_in_grid.y;
    BF16 up = BF16(arg(0) + 2 * uint64_t(r) * G * H), hn = BF16(arg(1) + 2 * uint64_t(r) * G * H);
    // `precise` and an explicit fma: the order the fused up kernels' gate
    // epilogue writes out too, so that both give the same bits (this is
    // how the compiler built this loop already; it built the fused
    // epilogue with a separate multiply and add in some instantiations).
    precise float acc = 0.0;
    for (uint g = 0; g < G; ++g) {
        float logit = float(up.v[g * H + i]);
        float gate = 1.0 / (1.0 + exp(-logit));
        acc = fma(gate, float(hn.v[g * H + i]), acc);
    }
    BF16(arg(2) + 2 * uint64_t(r) * H).v[i] = bf16_rne(acc / float(G));
}
#endif

#ifdef KERNEL_hc_inject_bf16
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    uint H = arg_u32(3), G = arg_u32(4);
    float inv_g = arg_f32(5);
    uint col = thread_position_in_grid.x, r = thread_position_in_grid.y;
    uint g = col / H, i = col % H;
    float logit = float(BF16(arg(2)).v[r * G + g]) * inv_g;
    float weight = 2.0 / (1.0 + exp(-logit));
    BF16 hyper = BF16(arg(0) + 2 * uint64_t(r) * G * H);
    hyper.v[col] = bf16_rne(float(hyper.v[col]) + float(BF16(arg(1) + 2 * uint64_t(r) * H).v[i]) * weight);
}
#endif

#ifdef KERNEL_hc_broadcast_bf16
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    uint H = arg_u32(2), G = arg_u32(3);
    uint col = thread_position_in_grid.x, r = thread_position_in_grid.y;
    BF16(arg(1) + 2 * uint64_t(r) * G * H).v[col] = BF16(arg(0) + 2 * uint64_t(r) * H).v[col % H];
}
#endif

// ---------------------------------------------------------------------------
// The fused read gate (hc.metal says what the two kernels compute and why).
// The down kernels are laid out as the Metal ones; the up kernels are not
// (see there).

#define HC_MAX_G 8

// The four Q8 codes of a word as floats.
vec4 hc_unpack_q8(uint word) {
    return vec4(float(word & 0xFFu), float((word >> 8) & 0xFFu),
                float((word >> 16) & 0xFFu), float((word >> 24) & 0xFFu));
}

// quant.metal's dot_word_q8 on unpacked codes and an activation in registers.
float hc_dot_q8(vec4 q, float s, float b, vec4 x) {
    return s * dot(q, x) + b * dot(x, vec4(1.0));
}

// The 16 bf16 values of a block whose words are a, b, widened: element 4j+c
// is component c of v[j] (a bf16 is the high half of its float).
void hc_widen_block(uvec4 a, uvec4 b, out vec4 v[4]) {
    v[0] = uintBitsToFloat(uvec4(a.x << 16, a.x & 0xFFFF0000u, a.y << 16, a.y & 0xFFFF0000u));
    v[1] = uintBitsToFloat(uvec4(a.z << 16, a.z & 0xFFFF0000u, a.w << 16, a.w & 0xFFFF0000u));
    v[2] = uintBitsToFloat(uvec4(b.x << 16, b.x & 0xFFFF0000u, b.y << 16, b.y & 0xFFFF0000u));
    v[3] = uintBitsToFloat(uvec4(b.z << 16, b.z & 0xFFFF0000u, b.w << 16, b.w & 0xFFFF0000u));
}

// Block i (elements 16i .. 16i+15) of the bf16 array at `p`, widened, loaded
// as two 16-byte words (Metal's bfloat4 loads): a bf16vec4 buffer reference
// load has 2-byte alignment and the driver splits it into 16-bit loads.
// Needs `p` 4-byte aligned, which every caller's operand is (H and R are
// multiples of 16).
void hc_load_block(uint64_t p, uint i, out vec4 v[4]) {
    U32x4 w = U32x4(p);
    hc_widen_block(w.v[2 * i], w.v[2 * i + 1], v);
}

// bf16 number `at` (0 to 7) of the eight in four words, widened.
float hc_half(uvec4 w, uint at) {
    uint word = at < 4u ? (at < 2u ? w.x : w.y) : (at < 6u ? w.z : w.w);
    return uintBitsToFloat((at & 1u) != 0u ? word & 0xFFFF0000u : word << 16);
}

// The quant group of the block a lane loads, i / bpg: Metal divides on
// every iteration, the port shifts (hc.rs only routes power-of-two quant
// groups here). An earlier stepped quotient kept a branch in the loop, and
// on this GPU a branch is a wait for every load before it: the shift took
// the three-row down kernel from 14.0 to 13.7 us a level in
// `hc_read_rows_chain_timing` (2026-11-13).
#define HC_GROUP_SHIFT(bpg) uint bsh = uint(findLSB(bpg));

#ifdef KERNEL_hc_read_down_q8
shared float part[HC_MAX_G];
shared float rms[HC_MAX_G];
void main() {
    uint H = arg_u32(11), G = arg_u32(12), R = arg_u32(13), NI = arg_u32(14), GS = arg_u32(15);
    float eps = arg_f32(16), w_bias = arg_f32(17);
    uint row = threadgroup_position_in_grid.x, tid = thread_index_in_threadgroup;
    uint g = simdgroup_index_in_threadgroup, lane = thread_index_in_simdgroup;
    if (row >= R + NI) return;  // whole threadgroup
    bool is_inj = row >= R;
    uint r = is_inj ? row - R : row;
    uint K = G * H;
    uint words = K / 4;
    uint bpg = GS / 16;
    uint groups = K / GS;
    uint stream_blocks = H / 16;
    U32x4 wrow = U32x4(arg(is_inj ? 5 : 2) + 4 * uint64_t(r) * words);
    BF16 scales = BF16(arg(is_inj ? 6 : 3) + 2 * (r * groups));
    BF16 biases = BF16(arg(is_inj ? 7 : 4) + 2 * (r * groups));

    float acc_w = 0.0;
    float acc_x2 = 0.0;
    uint i_end = (g + 1) * stream_blocks;
    HC_GROUP_SHIFT(bpg)
    for (uint i = g * stream_blocks + lane; i < i_end; i += 32) {
        uint q = i >> bsh;
        float s = float(scales.v[q]);
        float b = float(biases.v[q]);
        uvec4 w4 = wrow.v[i];
        vec4 xb[4], nb[4];
        hc_load_block(arg(0), i, xb);
        hc_load_block(arg(1), i, nb);
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            vec4 x = xb[j];
            vec4 xn = x * (w_bias + nb[j]);
            acc_w += hc_dot_q8(hc_unpack_q8(w4[j]), s, b, xn);
            acc_x2 += dot(x, x);
        }
    }
    acc_w = subgroupAdd(acc_w);
    acc_x2 = subgroupAdd(acc_x2);
    if (lane == 0) {
        float inv = inversesqrt(acc_x2 / float(H) + eps);
        part[g] = acc_w * inv;
        rms[g] = inv;
    }
    barrier();
    if (tid == 0) {
        float total = 0.0;
        for (uint s = 0; s < G; ++s) total += part[s];
        BF16(arg(is_inj ? 9 : 8)).v[r] = bf16_rne(total);
    }
    if (row == 0 && tid < G) F32(arg(10)).v[tid] = rms[tid];
}
#endif

// hc_read_down_q8 over MB rows (hc_read_down_q8_rows_body). Metal calls the
// body in two branches (inject, down); here the branch only picks the
// operands and one body is compiled.
//
// A threadgroup takes RPT consecutive weight rows (down rows, then inject
// rows), where the Metal kernel takes one: each lane runs the Metal lane's
// walk for every one of them, so a row's sums are added as there, but the
// MB hyper blocks and the norm block a lane loads, the normalized x * gain
// and the x . x sums are shared by the RPT rows instead of being loaded and
// computed per row. Those are what grows with MB (a weight block is 1
// load of 3 + 2 MB). `hc_read_rows_chain_timing`, H 2560, 4 streams, R 320,
// three rows, us per down level (2026-11-11): one row a threadgroup 17.4,
// two 15.5 to 15.8, four 17.9. One row (MB 1) keeps one: two were no
// faster. Bit for bit the single-row kernel's per row (hc.rs tests).
#if defined(KERNEL_hc_read_down_q8_m1)
#define MB 1
#elif defined(KERNEL_hc_read_down_q8_m2)
#define MB 2
#elif defined(KERNEL_hc_read_down_q8_m3)
#define MB 3
#elif defined(KERNEL_hc_read_down_q8_m4)
#define MB 4
#elif defined(KERNEL_hc_read_down_q8_m3_t1)
// The Metal layout, one row a threadgroup, for `hc_read_rows_chain_timing`.
#define MB 3
#define RPT 1
#endif
#ifdef MB
#define HC_READ_DOWN_ROWS
#ifndef RPT
#if MB == 1
#define RPT 1
#else
#define RPT 2
#endif
#endif
#endif

#ifdef HC_READ_DOWN_ROWS
shared float part[RPT * MB * HC_MAX_G];
shared float rms[MB * HC_MAX_G];
void main() {
    uint H = arg_u32(12), G = arg_u32(13), R = arg_u32(14), NI = arg_u32(15), GS = arg_u32(16);
    float eps = arg_f32(17), w_bias = arg_f32(18), inv_g = arg_f32(19);
    uint tid = thread_index_in_threadgroup;
    uint g = simdgroup_index_in_threadgroup, lane = thread_index_in_simdgroup;
    uint row0 = threadgroup_position_in_grid.x * RPT;
    if (row0 >= R + NI) return;  // whole threadgroup
    uint K = G * H;
    uint words = K / 4;
    uint bpg = GS / 16;
    uint groups = K / GS;
    uint stream_blocks = H / 16;
    // Row t of the threadgroup's (a row past the last runs on the last and
    // stores nothing).
    U32x4 wrow[RPT];
    BF16 scales[RPT], biases[RPT];
    [[unroll]] for (uint t = 0; t < RPT; ++t) {
        uint row = min(row0 + t, R + NI - 1);
        bool is_down = row < R;
        uint r = is_down ? row : row - R;
        wrow[t] = U32x4(arg(is_down ? 2 : 5) + 4 * uint64_t(r) * words);
        scales[t] = BF16(arg(is_down ? 3 : 6) + 2 * (r * groups));
        biases[t] = BF16(arg(is_down ? 4 : 7) + 2 * (r * groups));
    }
    float acc_w[RPT * MB];
    float acc_x2[MB];
    [[unroll]] for (uint m = 0; m < MB; ++m) {
        acc_x2[m] = 0.0;
        [[unroll]] for (uint t = 0; t < RPT; ++t) acc_w[t * MB + m] = 0.0;
    }
    uint i_end = (g + 1) * stream_blocks;
    HC_GROUP_SHIFT(bpg)
    for (uint i = g * stream_blocks + lane; i < i_end; i += 32) {
        uint q = i >> bsh;
        float s[RPT], b[RPT];
        uvec4 w4[RPT];
        [[unroll]] for (uint t = 0; t < RPT; ++t) {
            s[t] = float(scales[t].v[q]);
            b[t] = float(biases[t].v[q]);
            w4[t] = wrow[t].v[i];
        }
        vec4 nb[4], xb[MB][4];
        hc_load_block(arg(1), i, nb);
        // Row m's block i is block m * K/16 + i of hyper (32-bit: the rows
        // are [MB, G*H]).
        [[unroll]] for (uint m = 0; m < MB; ++m) hc_load_block(arg(0), m * (K / 16) + i, xb[m]);
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            vec4 gain = w_bias + nb[j];
            vec4 qf[RPT];
            [[unroll]] for (uint t = 0; t < RPT; ++t) qf[t] = hc_unpack_q8(w4[t][j]);
            [[unroll]] for (uint m = 0; m < MB; ++m) {
                vec4 x = xb[m][j];
                vec4 xn = x * gain;
                [[unroll]] for (uint t = 0; t < RPT; ++t)
                    acc_w[t * MB + m] += hc_dot_q8(qf[t], s[t], b[t], xn);
                acc_x2[m] += dot(x, x);
            }
        }
    }
    [[unroll]] for (uint m = 0; m < MB; ++m) {
        acc_x2[m] = subgroupAdd(acc_x2[m]);
        [[unroll]] for (uint t = 0; t < RPT; ++t) acc_w[t * MB + m] = subgroupAdd(acc_w[t * MB + m]);
    }
    if (lane == 0) {
        [[unroll]] for (uint m = 0; m < MB; ++m) {
            float inv = inversesqrt(acc_x2[m] / float(H) + eps);
            rms[m * HC_MAX_G + g] = inv;
            [[unroll]] for (uint t = 0; t < RPT; ++t) part[(t * MB + m) * HC_MAX_G + g] = acc_w[t * MB + m] * inv;
        }
    }
    barrier();
    // Thread t * MB + m stores row t's output of hyper row m.
    if (tid < RPT * MB) {
        uint t = tid / MB, m = tid - t * MB;
        uint row = row0 + t;
        if (row < R + NI) {
            bool is_down = row < R;
            uint r = is_down ? row : row - R;
            uint N = is_down ? R : NI;
            float total = 0.0;
            for (uint s = 0; s < G; ++s) total += part[(t * MB + m) * HC_MAX_G + s];
            bfloat16_t logit = bf16_rne(total);
            BF16(arg(is_down ? 8 : 9)).v[m * N + r] = logit;
            if (is_down) {
                // silu_scaled_bf16 on the bf16 logit.
                float v = float(logit) * inv_g;
                BF16(arg(11)).v[m * N + r] = bf16_rne(v / (1.0 + exp(-v)));
            }
        }
    }
    // The threadgroup of down row 0 publishes the stream RMS for the up kernel.
    if (row0 == 0 && R > 0 && tid < MB * G) F32(arg(10)).v[tid] = rms[(tid / G) * HC_MAX_G + tid % G];
}
#endif

