#elif defined(KERNEL_hc_read_up_mix_q8_g4_m2)
#define GG 4
#define MB 2
#elif defined(KERNEL_hc_read_up_mix_q8_g4_m3)
#define GG 4
#define MB 3
#elif defined(KERNEL_hc_read_up_mix_q8_g4_m4)
#define GG 4
#define MB 4
#elif defined(KERNEL_hc_read_up_mix_q8_g5_m1)
#define GG 5
#define MB 1
#elif defined(KERNEL_hc_read_up_mix_q8_g5_m2)
#define GG 5
#define MB 2
#elif defined(KERNEL_hc_read_up_mix_q8_g5_m3)
#define GG 5
#define MB 3
#elif defined(KERNEL_hc_read_up_mix_q8_g5_m4)
#define GG 5
#define MB 4
#elif defined(KERNEL_hc_read_up_mix_q8_g6_m1)
#define GG 6
#define MB 1
#elif defined(KERNEL_hc_read_up_mix_q8_g6_m2)
#define GG 6
#define MB 2
#elif defined(KERNEL_hc_read_up_mix_q8_g6_m3)
#define GG 6
#define MB 3
#elif defined(KERNEL_hc_read_up_mix_q8_g6_m4)
#define GG 6
#define MB 4
#elif defined(KERNEL_hc_read_up_mix_q8_g7_m1)
#define GG 7
#define MB 1
#elif defined(KERNEL_hc_read_up_mix_q8_g7_m2)
#define GG 7
#define MB 2
#elif defined(KERNEL_hc_read_up_mix_q8_g7_m3)
#define GG 7
#define MB 3
#elif defined(KERNEL_hc_read_up_mix_q8_g7_m4)
#define GG 7
#define MB 4
#elif defined(KERNEL_hc_read_up_mix_q8_g8_m1)
#define GG 8
#define MB 1
#elif defined(KERNEL_hc_read_up_mix_q8_g8_m2)
#define GG 8
#define MB 2
#elif defined(KERNEL_hc_read_up_mix_q8_g8_m3)
#define GG 8
#define MB 3
#elif defined(KERNEL_hc_read_up_mix_q8_g8_m4)
