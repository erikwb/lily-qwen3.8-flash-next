#version 460
// The kernels of src/kernels/metal/gemm.metal: BF16 C[M, N] = A[M, K] * B[N, K]^T
// with FP32 accumulation, on the matrix units (matmul.glsl). A threadgroup
// of two subgroups computes a 64x64 tile of C: subgroup s its rows 32 s..,
// as two 16-row blocks by four 16-column ones, eight accumulators.
//
// Where the port differs from Metal's kernel (one matmul2d over the tile on
// four simdgroups), and why, at M=4096, N=K=2560 (`gemm_nax_timing`,
// 2026-11-10; the first port, every block a coopMatLoad, is kept test-only
// in tests/vulkan/gemm_test.comp at 11.0 TFLOP/s; the multiplies alone with
// their operands in registers run at 57; Metal's kernel at 54):
//
// - K is walked 64 at a time in matmul.glsl's MAT_K64 pairing, operands
//   assembled from 16-byte loads of the two tensors' rows: 36 TFLOP/s with
//   four accumulators per subgroup, 30 in K order (four 4-byte loads per B
//   operand). The pairing regroups the products of a 64-deep group among its
//   four multiplies, so a result can round differently from the first
//   port's: 2 885 of 10.5 million outputs differed, by one bfloat ulp. The
//   result of a row or a column does not depend on M, N or its place in a
//   tile (`gemm_bf16_nt_results_do_not_depend_on_position`).
// - A subgroup holds a 32x64 tile, eight accumulators: its two A blocks
//   serve four B blocks, 1.0 load per multiply where a 16x64 tile has 1.5.
//   42 TFLOP/s. (With every load from one address, so nothing streams: 50.)
//   The subgroups share nothing, so the threadgroup's size does not matter
//   (32, 64 and 128 threads within 2%).
// - A column block's loads are issued before the block before it multiplies
//   (GEMM_GROUP): 44 TFLOP/s.
// - Edges do not branch in the K loop: a lane's rows past M read row M - 1
//   and its columns past N row N - 1 of B (products never stored). A K that
//   is not a multiple of 64, or tensors the 16-byte loads cannot address
//   (K not a multiple of 8, a base address not a multiple of 4), take
//   16-deep steps staged through threadgroup memory, in K order, for the
//   rest: the tests' shapes, none of the model's.
//
// What did not pay: A by 8-byte loads with no vector loaded twice (a pairing
// with bfloats t and t + 4: 42.6 against 42.5), two groups per loop
// iteration (the accumulators' moves at the loop's end are not what costs),
// taller threadgroups to share the B tile (the loads cost per subgroup that
// issues them, not per byte new to the core).
#include "common.glsl"
#include "matmul.glsl"

shared bfloat16_t mat_stage[MAT_STAGE_ELEMENTS(2)];

#if defined(KERNEL_gemm_bf16_nt_nax) || defined(KERNEL_gemm_bf16_nt_bias_nax)
// The lane's vectors of its two rows of one A block for a group, and the
// four multiplies' operands from them.
#define GEMM_A_LOAD(m, at0, at1)                                                              \
    uvec4 m##00 = aw.v[at0], m##01 = aw.v[(at0) + 1], m##02 = aw.v[(at0) + 2], m##03 = aw.v[(at0) + 3]; \
    uvec4 m##10 = aw.v[at1], m##11 = aw.v[(at1) + 1], m##12 = aw.v[(at1) + 2], m##13 = aw.v[(at1) + 3];
#define GEMM_A_BLOCK(m, v)                                                                    \
    MatA m##0, m##1, m##2, m##3;                                                              \
    MAT_K64_A(m##0, m##1, m##2, m##3, v##00, v##01, v##02, v##03, v##10, v##11, v##12, v##13, odd16)
// Column block bb: the lane's vector of each of its four columns (`at(bb, j)`
// its index), and the block's four multiplies against both A blocks.
#define GEMM_B_LOAD(bb, at)                                                                   \
    uvec4 w##bb##0 = bw.v[at(bb, 0)], w##bb##1 = bw.v[at(bb, 1)], w##bb##2 = bw.v[at(bb, 2)], w##bb##3 = bw.v[at(bb, 3)];
#define GEMM_B_STEP(bb, t)                                                                    \
    MAT_K64_B(mb, t, w##bb##0, w##bb##1, w##bb##2, w##bb##3)                                  \
    acc0##bb = coopMatMulAdd(ma##t, mb, acc0##bb);                                            \
    acc1##bb = coopMatMulAdd(mc##t, mb, acc1##bb);
#define GEMM_B_BLOCK(bb) GEMM_B_STEP(bb, 0) GEMM_B_STEP(bb, 1) GEMM_B_STEP(bb, 2) GEMM_B_STEP(bb, 3)
// A group. Loads are issued ahead of their use, each column block's while
// the block before it multiplies: a thread waits where it first uses a
// loaded value, and only for what is still in flight then (matmul.glsl).
// 41.0 TFLOP/s with each block's loads issued where the block begins, 44.4
// this way; with all of A's sixteen ahead of the first block 39.7.
#define GEMM_GROUP(at)                                                                        \
    {                                                                                         \
        GEMM_A_LOAD(va, a00 + g, a01 + g)                                                     \
        GEMM_A_BLOCK(ma, va)                                                                  \
        GEMM_A_LOAD(vc, a10 + g, a11 + g)                                                     \
        GEMM_B_LOAD(0, at)                                                                    \
        GEMM_A_BLOCK(mc, vc)                                                                  \
        MatB mb;                                                                              \
        GEMM_B_LOAD(1, at) GEMM_B_BLOCK(0)                                                    \
        GEMM_B_LOAD(2, at) GEMM_B_BLOCK(1)                                                    \
        GEMM_B_LOAD(3, at) GEMM_B_BLOCK(2)                                                    \
        GEMM_B_BLOCK(3)                                                                       \
    }
// A tile inside N: the lane's columns are rows b_at / K8 + 16 bb + j of B.
#define GEMM_B_INSIDE(bb, j) (b_at + g + (16 * bb + j) * K8)
// A tile across N: columns past it read B's last row.
#define GEMM_B_CLAMPED(bb, j) (min(b_col + (16 * bb + j), N - 1) * K8 + b_vec + g)

// A 16-deep step in K order with the block's edges staged as zeros: the K
// tail, and all of K where the tensors cannot be loaded 16 bytes at a time.
#define GEMM_TAIL_A(m, i)                                                                     \
    MatA m;                                                                                   \
    {                                                                                         \
        uint r0 = row0 + 16 * i;                                                              \
        MAT_STAGE(a + 2 * (uint64_t(r0) * K + k0), K, r0 < M ? min(16u, M - r0) : 0u, depth)  \
        MAT_LOAD_STAGED_A(m);                                                                 \
    }
#define GEMM_TAIL_B(bb)                                                                       \
    {                                                                                         \
        uint c0 = col0 + 16 * bb;                                                             \
        MatB mb;                                                                              \
        MAT_STAGE(b + 2 * (uint64_t(c0) * K + k0), K, c0 < N ? min(16u, N - c0) : 0u, depth)  \
        MAT_LOAD_STAGED_B(mb);                                                                \
        acc0##bb = coopMatMulAdd(ta0, mb, acc0##bb);                                          \
        acc1##bb = coopMatMulAdd(ta1, mb, acc1##bb);                                          \
    }

// A lane's part of one accumulator: four columns of two rows.
#define GEMM_STORE(acc, i, bb)                                                                \
    for (uint h = 0; h < 2; ++h) {                                                            \
        uint row = 16 * i + lane_row + h, col = col0 + 16 * bb + lane_col;                    \
        if (row0 + row >= M || col >= N) continue;                                            \
        vec4 v = vec4(acc[4 * h], acc[4 * h + 1], acc[4 * h + 2], acc[4 * h + 3]);            \
        GEMM_BIAS(v, col)                                                                     \
        if (c_wide) {                                                                         \
            MAT_STORE_HALF(c_tile, row * N + col, v);                                         \
        } else if ((N & 3) == 0) {                                                            \
            MAT_STORE_HALF_UNALIGNED(c_tile, row * N + col, v);                               \
        } else {                                                                              \
            for (uint j = 0; j < 4 && col + j < N; ++j) BF16(c_tile).v[row * N + col + j] = bfloat16_t(v[j]); \
        }                                                                                     \
    }
#ifdef KERNEL_gemm_bf16_nt_bias_nax
// The bias goes in before the one rounding, as a Linear layer's.
#define GEMM_BIAS(v, col)                                                                     \
    for (uint j = 0; j < 4 && col + j < N; ++j) v[j] += float(bias.v[col + j]);
#else
#define GEMM_BIAS(v, col)
#endif

void main() {
    uint64_t a = arg(0), b = arg(1), c = arg(2);
#ifdef KERNEL_gemm_bf16_nt_bias_nax
    BF16 bias = BF16(arg(3));
    uint K = arg_u32(4), N = arg_u32(5), M = arg_u32(6);
#else
    uint K = arg_u32(3), N = arg_u32(4), M = arg_u32(5);
#endif
    uint row0 = threadgroup_position_in_grid.y * 64 + 32 * gl_SubgroupID;
    uint col0 = threadgroup_position_in_grid.x * 64;
    uint lane_row = mat_lane_row(), lane_col = mat_lane_col();
    uint odd16 = 16 * mat_a_odd();

    MatC acc00 = MatC(0.0), acc01 = MatC(0.0), acc02 = MatC(0.0), acc03 = MatC(0.0);
    MatC acc10 = MatC(0.0), acc11 = MatC(0.0), acc12 = MatC(0.0), acc13 = MatC(0.0);

    // The 64-deep groups: vector indices into the tensors, 8 bfloats each.
    bool wide = ((a | b) & 3) == 0 && (K & 7) == 0;
    uint K64 = wide ? K & ~63u : 0u;
    uint K8 = K / 8, G8 = K64 / 8;
    U32x4 aw = U32x4(a), bw = U32x4(b);
    uint a_row = row0 + lane_row, a_vec = 4 * mat_a_half();
    uint a00 = min(a_row, M - 1) * K8 + a_vec, a01 = min(a_row + 1, M - 1) * K8 + a_vec;
    uint a10 = min(a_row + 16, M - 1) * K8 + a_vec, a11 = min(a_row + 17, M - 1) * K8 + a_vec;
    uint b_col = col0 + lane_col, b_vec = lane_row / 2;
    uint b_at = b_col * K8 + b_vec;
    if (col0 + 64 <= N) {
        for (uint g = 0; g < G8; g += 8) GEMM_GROUP(GEMM_B_INSIDE)
    } else {
        for (uint g = 0; g < G8; g += 8) GEMM_GROUP(GEMM_B_CLAMPED)
    }

    for (uint k0 = K64; k0 < K; k0 += 16) {
        uint depth = min(16u, K - k0);
        GEMM_TAIL_A(ta0, 0)
        GEMM_TAIL_A(ta1, 1)
        GEMM_TAIL_B(0) GEMM_TAIL_B(1) GEMM_TAIL_B(2) GEMM_TAIL_B(3)
    }

    uint64_t c_tile = c + uint64_t(row0) * (2 * N);
    // Four columns in one store where they are four whole bfloats of a
    // word-aligned row.
    bool c_wide = (N & 3) == 0 && (c_tile & 3) == 0;
    GEMM_STORE(acc00, 0, 0) GEMM_STORE(acc01, 0, 1) GEMM_STORE(acc02, 0, 2) GEMM_STORE(acc03, 0, 3)
    GEMM_STORE(acc10, 1, 0) GEMM_STORE(acc11, 1, 1) GEMM_STORE(acc12, 1, 2) GEMM_STORE(acc13, 1, 3)
}
#endif
