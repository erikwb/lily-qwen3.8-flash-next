#version 460
// GLM 5.3 Flash prefill GEMMs (src/kernels/glm53.rs `gemm`, `moe_grouped`):
// Y[m][n] = X[m] . W[n] for runs of prompt rows, W GGUF blocks decoded
// exactly (glm53_quant.glsl) and rounded to bfloat, f32 accumulators on the
// matrix units. Both follow Qwen's grouped GEMM (quant_grouped.glsl): a
// threadgroup of four subgroups computes 64 rows x 64 columns, every thread
// decodes 8 values of 4 weight rows of a 64-deep K step into a tile in the
// lanes' order (one load per B operand), two tiles in turn, one barrier a
// step; a subgroup owns 16 rows and all 64 columns and reads its rows of X
// from device memory. Rows past M and N are clamped on load and not stored.
// Batches (grid z) step X, W and Y by their own strides: the per-head
// attn_k_b and attn_v_b projections.
// Buffers: 0 X, 1 W, 2 Y. Params: 3 M, 4 N, 5 K, 6 row_bytes, 7 ldx,
// 8 ldy, 9 x_batch (elements), 10 w_batch (rows), 11 y_batch (elements).
#include "common.glsl"
#include "glm53_quant.glsl"
#include "matmul.glsl"

// float to bfloat bits, rounded to nearest even (no NaN case: the operands
// are finite).
uint glm53_bf16_bits(float f) {
    const uint u = floatBitsToUint(f);
    return (u + 0x7fffu + ((u >> 16u) & 1u)) >> 16u;
}

#if defined(KERNEL_glm53_gemm_q8_0) || defined(KERNEL_glm53_gemm_q4_k) || \
    defined(KERNEL_glm53_gemm_bf16) || defined(KERNEL_glm53_gemm_f32) || \
    defined(KERNEL_glm53_gemm_moe_iq2_xxs) || defined(KERNEL_glm53_gemm_moe_q2_k) || \
    defined(KERNEL_glm53_gemm_moe_gate_up_iq2_xxs)
#define GM_STEP 64u
// Vector (k - k0) / 2 * 16 + n / 4 of a step's tile holds weights k and
// k + 1 of the tile's rows n .. n + 3 (quant_grouped.glsl's qg_tile).
shared uvec4 gm_tile[2u * GM_STEP * 8u];

uint gm_pair(uint lo, uint hi) { return (lo >> 16u) | (hi & 0xffff0000u); }
uint gm_round(float f) {
    const uint u = floatBitsToUint(f);
    return u + 0x7fffu + ((u >> 16u) & 1u);
}

// A thread's share of a step's tile: weights k .. k + 8 of four rows
// (decode8(row, k, w)), rounded and stored in the lanes' order at `at`.
#define GM_STORE_TILE(at, w)                                                                  \
    [[unroll]] for (uint i = 0u; i < 4u; i++) {                                               \
        gm_tile[(at) + 16u * i] = uvec4(                                                      \
            gm_pair(gm_round(w[0][2u * i]), gm_round(w[1][2u * i])),                          \
            gm_pair(gm_round(w[2][2u * i]), gm_round(w[3][2u * i])),                          \
            gm_pair(gm_round(w[0][2u * i + 1u]), gm_round(w[1][2u * i + 1u])),                \
            gm_pair(gm_round(w[2][2u * i + 1u]), gm_round(w[3][2u * i + 1u])));               \
    }
#endif

#if defined(KERNEL_glm53_gemm_q8_0) || defined(KERNEL_glm53_gemm_q4_k) || \
    defined(KERNEL_glm53_gemm_bf16) || defined(KERNEL_glm53_gemm_f32)
#if defined(KERNEL_glm53_gemm_q8_0)
#define GEMM_TYPE GLM53_Q8_0
#elif defined(KERNEL_glm53_gemm_q4_k)
#define GEMM_TYPE GLM53_Q4_K
#elif defined(KERNEL_glm53_gemm_bf16)
#define GEMM_TYPE GLM53_BF16
#else
#define GEMM_TYPE GLM53_F32
#endif

// Weights k .. k + 8 (k a multiple of 8) of `row`, as glm53_decode gives
// them.
void gd_decode8(uint64_t row, uint k, out float w[8]) {
    if (GEMM_TYPE == GLM53_Q8_0) {
        const uint64_t b = row + uint64_t(k >> 5u) * 34u;
        const float d = glm53_h2f(uint(U16(b).v[0]));
        [[unroll]] for (uint i = 0u; i < 4u; i++) {
            const uint pair = uint(U16(b + 2u).v[((k & 31u) >> 1u) + i]);
            w[2u * i] = d * float(int(pair << 24) >> 24);
            w[2u * i + 1u] = d * float(int(pair << 16) >> 24);
        }
    } else if (GEMM_TYPE == GLM53_Q4_K) {
        const uint64_t b = row + uint64_t(k >> 8u) * 144u;
        const uint j = (k >> 5u) & 7u;
        const uint dd = U32(b).v[0];
        const float d = glm53_h2f(dd & 0xffffu);
        const float dmin = glm53_h2f(dd >> 16u);
        const uvec3 sw = uvec3(U32(b + 4u).v[0], U32(b + 8u).v[0], U32(b + 12u).v[0]);
        #define Q4K_BYTE(i) ((sw[(i) >> 2u] >> (8u * ((i) & 3u))) & 0xffu)
        uint sc, m;
        if (j < 4u) {
            sc = Q4K_BYTE(j) & 63u;
            m = Q4K_BYTE(j + 4u) & 63u;
        } else {
            sc = (Q4K_BYTE(j + 4u) & 0xfu) | ((Q4K_BYTE(j - 4u) >> 6u) << 4u);
            m = (Q4K_BYTE(j + 4u) >> 4u) | ((Q4K_BYTE(j) >> 6u) << 4u);
        }
        #undef Q4K_BYTE
        const float scale = d * float(sc);
        const float minv = dmin * float(m);
        const uvec2 q = U32x2(b + 16u + (j >> 1u) * 32u + (k & 31u)).v[0] >> ((j & 1u) * 4u);
        [[unroll]] for (uint i = 0u; i < 8u; i++) {
            w[i] = scale * float((q[i >> 2u] >> (8u * (i & 3u))) & 0xfu) - minv;
        }
    } else if (GEMM_TYPE == GLM53_BF16) {
        const uvec4 v = U32x4(row + 2u * k).v[0];
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            w[2u * c] = uintBitsToFloat(v[c] << 16u);
            w[2u * c + 1u] = uintBitsToFloat(v[c] & 0xffff0000u);
        }
    } else {
        const vec4 v0 = F32x4(row + 4u * k).v[0], v1 = F32x4(row + 4u * k + 16u).v[0];
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            w[c] = v0[c];
            w[4u + c] = v1[c];
        }
    }
}


// The dense GEMM in the expert GEMM's layout (below): every thread decodes
// 8 values of 4 weight rows of a 64-deep step into the tile in the lanes'
// order, and a subgroup multiplies its 16 rows of X against all 64 columns,
// reading X straight from device memory as floats and rounding to bfloat
// only the elements its lanes hold (a lane of an A operand uses every other
// value of eight). K must be a multiple of 64.
void main() {
    const uint M = arg_u32(3);
    const uint N = arg_u32(4);
    const uint K = arg_u32(5);
    const uint row_bytes = arg_u32(6);
    const uint ldx = arg_u32(7);
    const uint ldy = arg_u32(8);
    const uint batch = gl_WorkGroupID.z;
    const uint64_t X = arg(0) + 4u * uint64_t(batch) * arg_u32(9);
    const uint64_t W = arg(1) + uint64_t(batch) * arg_u32(10) * row_bytes;
    const uint64_t Y = arg(2) + 4u * uint64_t(batch) * arg_u32(11);
    const uint m0 = gl_WorkGroupID.y * 64u;
    const uint n0 = gl_WorkGroupID.x * 64u;
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint quad = tid & 15u, k8 = tid >> 4u;
    uint64_t wr[4];
    [[unroll]] for (uint r = 0u; r < 4u; r++) wr[r] = W + uint64_t(min(n0 + 4u * quad + r, N - 1u)) * row_bytes;
    const uint rows = min(64u, M - m0);
    const uint row0 = 16u * sg;
    const bool working = row0 < rows;
    const uint lane_row = mat_lane_row(), a_half = mat_a_half();
    const bool odd = mat_a_odd() != 0u;
    // The lanes' two rows of X, in vec4 units (ldx is a multiple of 4).
    const uint xi0 = (m0 + min(row0 + lane_row, rows - 1u)) * (ldx / 4u) + 2u * a_half;
    const uint xi1 = (m0 + min(row0 + lane_row + 1u, rows - 1u)) * (ldx / 4u) + 2u * a_half;
    F32x4 xa = F32x4(X);
    const uint lane_at = lane_row * 8u + mat_lane_col() / 4u;
    MatC acc0 = MatC(0.0), acc1 = MatC(0.0), acc2 = MatC(0.0), acc3 = MatC(0.0);
    for (uint k0 = 0u; k0 < K; k0 += GM_STEP) {
        const uint tile_at = ((k0 / GM_STEP) & 1u) * (GM_STEP * 8u);
        {
            float w[4][8];
            [[unroll]] for (uint r = 0u; r < 4u; r++) gd_decode8(wr[r], k0 + 8u * k8, w[r]);
            GM_STORE_TILE(tile_at + 64u * k8 + quad, w)
        }
        barrier();
        if (working) {
            [[unroll]] for (uint kk = 0u; kk < GM_STEP; kk += 16u) {
                const uint at = (k0 + kk) / 4u;
                const vec4 p0 = xa.v[xi0 + at], p1 = xa.v[xi0 + at + 1u];
                const vec4 q0 = xa.v[xi1 + at], q1 = xa.v[xi1 + at + 1u];
                const uint b_at = tile_at + lane_at + kk * 8u;
                const uvec4 b0 = gm_tile[b_at], b1 = gm_tile[b_at + 4u];
                const uvec4 b2 = gm_tile[b_at + 8u], b3 = gm_tile[b_at + 12u];
                MatA ma;
                MatB mb;
                // Element e of the lane's row is value 2 e + odd of the eight.
                ma[0] = MAT_HI(gm_round(odd ? p0.y : p0.x));
                ma[1] = MAT_HI(gm_round(odd ? p0.w : p0.z));
                ma[2] = MAT_HI(gm_round(odd ? p1.y : p1.x));
                ma[3] = MAT_HI(gm_round(odd ? p1.w : p1.z));
                ma[4] = MAT_HI(gm_round(odd ? q0.y : q0.x));
                ma[5] = MAT_HI(gm_round(odd ? q0.w : q0.z));
                ma[6] = MAT_HI(gm_round(odd ? q1.y : q1.x));
                ma[7] = MAT_HI(gm_round(odd ? q1.w : q1.z));
                MAT_OF_WORDS(mb, b0)
                acc0 = coopMatMulAdd(ma, mb, acc0);
                MAT_OF_WORDS(mb, b1)
                acc1 = coopMatMulAdd(ma, mb, acc1);
                MAT_OF_WORDS(mb, b2)
                acc2 = coopMatMulAdd(ma, mb, acc2);
                MAT_OF_WORDS(mb, b3)
                acc3 = coopMatMulAdd(ma, mb, acc3);
            }
        }
    }
    if (!working) return;
    const uint col = n0 + mat_lane_col();
    [[unroll]] for (uint h = 0u; h < 2u; h++) {
        const uint r = row0 + lane_row + h;
        if (r < rows) {
            const uint64_t y = Y + 4u * uint64_t(m0 + r) * ldy;
            [[unroll]] for (uint c = 0u; c < 4u; c++) {
                if (col + c < N) F32(y).v[col + c] = acc0[4u * h + c];
                if (col + 16u + c < N) F32(y).v[col + 16u + c] = acc1[4u * h + c];
                if (col + 32u + c < N) F32(y).v[col + 32u + c] = acc2[4u * h + c];
                if (col + 48u + c < N) F32(y).v[col + 48u + c] = acc3[4u * h + c];
            }
        }
    }
}
#endif

// ---------------------------------------------------------------------------
// Routed experts over a run of rows, grouped by expert (the layout of
// quant_grouped.glsl, Qwen's grouped GEMM): tile y is tiles[y] = (expert,
// first, count) of the expert-sorted pair list `pairs` (glm53_moe_group);
// its rows are pairs[first ..], X row pairs[k] >> x_shift (the token for
// gate/up, the pair for down), Y row pairs[k]. X is bfloat (glm53_to_bf16,
// glm53_moe_swiglu), read by each subgroup straight from device memory
// (MAT_A_OF_ROWS). A threadgroup of four subgroups computes 64 rows x 64
// columns; a subgroup owns 16 rows (none past the tile's: no multiplies)
// and all 64 columns, and every thread dequantizes 8 weights of 4 weight
// rows a 64-deep K step into the tile in the lanes' order (one load per B
// operand), two tiles in turn so one barrier a step. The decoded values are
// glm53_decode's, rounded to bfloat as before.
// Buffers: 0 X (bfloat), 1 W (the expert stack), 2 Y f32, 3 pairs u32,
// 4 tiles u32 [3 per tile], 5 tile count u32. Params: 6 N (rows per
// expert), 7 K (a multiple of 256), 8 row_bytes, 9 x_shift.
// glm53_gemm_moe_gate_up_iq2_xxs computes gate (W) and up (buffer 6) of
// 32 columns a tile, grid (N / 32, tiles), and writes the weighted clamped
// SwiGLU of each pair (weights f32 at buffer 7) to Y as bfloat, the down
// GEMM's operand; its params are 8 N, 9 K, 10 row_bytes, 11 x_shift,
// 12 limit.
// ---------------------------------------------------------------------------
#if defined(KERNEL_glm53_gemm_moe_iq2_xxs) || defined(KERNEL_glm53_gemm_moe_q2_k) || \
    defined(KERNEL_glm53_gemm_moe_gate_up_iq2_xxs)
#ifdef KERNEL_glm53_gemm_moe_gate_up_iq2_xxs
#define GM_GATE_UP 1
#define GM_P 8u
#else
#define GM_P 6u
#endif

// Weights k .. k + 8 (k a multiple of 8) of `row`.
void gm_decode8(uint64_t row, uint k, out float w[8]) {
#if defined(KERNEL_glm53_gemm_moe_iq2_xxs) || defined(GM_GATE_UP)
    const uint t = k >> 5u, l = (k >> 3u) & 3u;
    const uint bw = (t >> 3u) * 33u;
    const uint qw = bw + 1u + 4u * (t & 7u);
    const float d = glm53_h2f(uint(U16(row).v[bw]));
    const uint aux0 = uint(U16(row).v[qw]) | (uint(U16(row).v[qw + 1u]) << 16u);
    const uint aux1 = uint(U16(row).v[qw + 2u]) | (uint(U16(row).v[qw + 3u]) << 16u);
    const float scale = 0.125 * d * float(2u * (aux1 >> 28u) + 1u);
    const uvec4 g = glm53_iq2xxs_grid_h[(aux0 >> (8u * l)) & 0xffu]
                  ^ glm53_iq2xxs_signs_h[(aux1 >> (7u * l)) & 127u];
    // Word p holds values p and p + 4.
    [[unroll]] for (uint p = 0u; p < 4u; p++) {
        const vec2 v = unpackHalf2x16(g[p]);
        w[p] = scale * v.x;
        w[p + 4u] = scale * v.y;
    }
#else
    // Block k / 256, half h, shift j, bytes l .. l + 8 of the half's 32;
    // group 8 h + 2 j + l / 16.
    const uint v = k & 255u, h = v >> 7u, j = (v >> 5u) & 3u, l = v & 31u;
    const uint64_t b = row + uint64_t(k >> 8u) * 84u;
    const uint dd = U32(b + 80u).v[0];
    const float d = glm53_h2f(dd & 0xffffu);
    const float dmin = glm53_h2f(dd >> 16u);
    const uint sc = uint(U8(b).v[8u * h + 2u * j + (l >> 4u)]);
    const float scale = d * float(sc & 0xfu);
    const float minv = dmin * float(sc >> 4u);
    const uvec2 q = U32x2(b + 16u + 32u * h + l).v[0];
    [[unroll]] for (uint i = 0u; i < 8u; i++) {
        w[i] = scale * float((q[i >> 2u] >> (8u * (i & 3u) + 2u * j)) & 3u) - minv;
    }
#endif
}

void main() {
    if (gl_WorkGroupID.y >= U32(arg(5)).v[0]) return;
    const uint N = arg_u32(GM_P);
    const uint K = arg_u32(GM_P + 1u);
    const uint row_bytes = arg_u32(GM_P + 2u);
    const uint x_shift = arg_u32(GM_P + 3u);
    const uint expert = U32(arg(4)).v[3u * gl_WorkGroupID.y];
    const uint first = U32(arg(4)).v[3u * gl_WorkGroupID.y + 1u];
    const uint rows = U32(arg(4)).v[3u * gl_WorkGroupID.y + 2u];
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    // This thread's dequantization: weight rows 4 quad .. + 4 of the tile,
    // values 8 k8 .. + 8 of each step.
    const uint quad = tid & 15u, k8 = tid >> 4u;
    uint64_t wr[4];
#ifdef GM_GATE_UP
    // The tile's 64 weight rows are rows n0 .. n0 + 32 of gate (column
    // blocks 0 and 1) and the same rows of up (blocks 2 and 3).
    const uint n0 = gl_WorkGroupID.x * 32u;
    const uint64_t W = (quad < 8u ? arg(1) : arg(6)) + (uint64_t(expert) * N + n0) * row_bytes;
    [[unroll]] for (uint r = 0u; r < 4u; r++) wr[r] = W + uint64_t(min(4u * (quad & 7u) + r, N - 1u - n0)) * row_bytes;
#else
    const uint n0 = gl_WorkGroupID.x * 64u;
    const uint64_t W = arg(1) + (uint64_t(expert) * N + n0) * row_bytes;
    [[unroll]] for (uint r = 0u; r < 4u; r++) wr[r] = W + uint64_t(min(4u * quad + r, N - 1u - n0)) * row_bytes;
#endif
    // The subgroup's rows, and its lanes' two rows of X (a row past the
    // tile's reads the tile's last and is not stored).
    const uint row0 = 16u * sg;
    const bool working = row0 < rows;
    const uint lane_row = mat_lane_row(), a_half = mat_a_half(), odd16 = 16u * mat_a_odd();
    const uint words = K / 8u;
    const uint x0 = U32(arg(3)).v[first + min(row0 + lane_row, rows - 1u)] >> x_shift;
    const uint x1 = U32(arg(3)).v[first + min(row0 + lane_row + 1u, rows - 1u)] >> x_shift;
    const uint a_at0 = x0 * words, a_at1 = x1 * words;
    U32x4 xa = U32x4(arg(0));
    const uint lane_at = lane_row * 8u + mat_lane_col() / 4u;
    MatC acc0 = MatC(0.0), acc1 = MatC(0.0), acc2 = MatC(0.0), acc3 = MatC(0.0);
    for (uint k0 = 0u; k0 < K; k0 += GM_STEP) {
        const uint tile_at = ((k0 / GM_STEP) & 1u) * (GM_STEP * 8u);
        {
            float w[4][8];
            [[unroll]] for (uint r = 0u; r < 4u; r++) gm_decode8(wr[r], k0 + 8u * k8, w[r]);
            GM_STORE_TILE(tile_at + 64u * k8 + quad, w)
        }
        barrier();
        if (working) {
            [[unroll]] for (uint kk = 0u; kk < GM_STEP; kk += 16u) {
                const uint at = (k0 + kk) / 8u + a_half;
                const uint b_at = tile_at + lane_at + kk * 8u;
                const uvec4 v0 = xa.v[a_at0 + at], v1 = xa.v[a_at1 + at];
                const uvec4 b0 = gm_tile[b_at], b1 = gm_tile[b_at + 4u];
                const uvec4 b2 = gm_tile[b_at + 8u], b3 = gm_tile[b_at + 12u];
                MatA ma;
                MatB mb;
                MAT_A_OF_ROWS(ma, v0, v1, odd16)
                MAT_OF_WORDS(mb, b0)
                acc0 = coopMatMulAdd(ma, mb, acc0);
                MAT_OF_WORDS(mb, b1)
                acc1 = coopMatMulAdd(ma, mb, acc1);
                MAT_OF_WORDS(mb, b2)
                acc2 = coopMatMulAdd(ma, mb, acc2);
                MAT_OF_WORDS(mb, b3)
                acc3 = coopMatMulAdd(ma, mb, acc3);
            }
        }
    }
    if (!working) return;
    const uint col = n0 + mat_lane_col();
#ifdef GM_GATE_UP
    // mid[p][j] = w[p] * silu(min(g, L)) * clamp(u, -L, L) as bfloat (the
    // SwiGLU of glm53_moe_swiglu, from the same sums).
    const float limit = arg_f32(12);
    [[unroll]] for (uint h = 0u; h < 2u; h++) {
        const uint r = row0 + lane_row + h;
        if (r < rows) {
            const uint p = U32(arg(3)).v[first + r];
            const float we = F32(arg(7)).v[p];
            [[unroll]] for (uint half_ = 0u; half_ < 2u; half_++) {
                uint b[4];
                [[unroll]] for (uint c = 0u; c < 4u; c++) {
                    float g = half_ == 0u ? acc0[4u * h + c] : acc1[4u * h + c];
                    float u = half_ == 0u ? acc2[4u * h + c] : acc3[4u * h + c];
                    if (limit > 1e-6) {
                        g = min(g, limit);
                        u = clamp(u, -limit, limit);
                    }
                    // glm53_moe_swiglu's value in its order:
                    // w ((g u) / (1 + 2^(-g log2 e))).
                    precise float gu = g * u;
                    precise float e = exp2(-(g * uintBitsToFloat(0x3fb8aa3bu)));
                    precise float sv = we * (gu * (1.0 / (1.0 + e)));
                    b[c] = glm53_bf16_bits(sv);
                }
                const uint64_t at = arg(2) + 2u * (uint64_t(p) * N + col + 16u * half_);
                U32x2(at).v[0] = uvec2(b[0] | (b[1] << 16u), b[2] | (b[3] << 16u));
            }
        }
    }
#else
    [[unroll]] for (uint h = 0u; h < 2u; h++) {
        const uint r = row0 + lane_row + h;
        if (r < rows) {
            const uint64_t y = arg(2) + 4u * uint64_t(U32(arg(3)).v[first + r]) * N;
            F32x4(y).v[(col + 0u) / 4u] = vec4(acc0[4u * h], acc0[4u * h + 1u], acc0[4u * h + 2u], acc0[4u * h + 3u]);
            F32x4(y).v[(col + 16u) / 4u] = vec4(acc1[4u * h], acc1[4u * h + 1u], acc1[4u * h + 2u], acc1[4u * h + 3u]);
            F32x4(y).v[(col + 32u) / 4u] = vec4(acc2[4u * h], acc2[4u * h + 1u], acc2[4u * h + 2u], acc2[4u * h + 3u]);
            F32x4(y).v[(col + 48u) / 4u] = vec4(acc3[4u * h], acc3[4u * h + 1u], acc3[4u * h + 2u], acc3[4u * h + 3u]);
        }
    }
#endif
}
#endif

// ---------------------------------------------------------------------------
// x as bfloat bits (glm53_bf16_bits), two values a word: the expert GEMM's
// operand. Grid::Threads (n / 2). Buffers: 0 x f32, 1 out (bfloat).
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_to_bf16
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    const uint i = gl_GlobalInvocationID.x;
    const vec2 v = vec2(F32(arg(0)).v[2u * i], F32(arg(0)).v[2u * i + 1u]);
    U32(arg(1)).v[i] = glm53_bf16_bits(v.x) | (glm53_bf16_bits(v.y) << 16u);
}
#endif

// ---------------------------------------------------------------------------
// Groups a run's routed pairs (row i, slot s: pair i * used + s) by expert:
// pairs sorted by expert (order inside an expert arbitrary: each pair's
// result goes to its own row), and a tile list of (expert, first, count)
// with at most 64 pairs a tile. One threadgroup of 1024.
// Buffers: 0 sel u32 [pairs], 1 pairs out, 2 tiles out [3 per tile], 3 tile
// count out. Params: 4 number of pairs, 5 experts (<= 512).
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_moe_group
shared uint counts[512];
shared uint offsets[512];
void main() {
    const uint n = arg_u32(4);
    const uint E = arg_u32(5);
    const uint tid = gl_LocalInvocationIndex;
    for (uint e = tid; e < E; e += 1024u) counts[e] = 0u;
    barrier();
    for (uint p = tid; p < n; p += 1024u) atomicAdd(counts[U32(arg(0)).v[p]], 1u);
    barrier();
    if (tid == 0u) {
        uint at = 0u, tiles = 0u;
        for (uint e = 0u; e < E; e++) {
            const uint c = counts[e];
            offsets[e] = at;
            for (uint s = 0u; s < c; s += 64u) {
                U32(arg(2)).v[3u * tiles] = e;
                U32(arg(2)).v[3u * tiles + 1u] = at + s;
                U32(arg(2)).v[3u * tiles + 2u] = min(64u, c - s);
                tiles++;
            }
            at += c;
        }
        U32(arg(3)).v[0] = tiles;
    }
    barrier();
    for (uint p = tid; p < n; p += 1024u) {
        const uint e = U32(arg(0)).v[p];
        const uint k = atomicAdd(offsets[e], 1u);
        U32(arg(1)).v[k] = p;
    }
}
#endif

// ---------------------------------------------------------------------------
// mid[p][j] = w[p] * silu(min(g, L)) * clamp(u, -L, L) for every routed pair.
// Grid::Threads (F, pairs). Buffers: 0 g [pairs][F], 1 u, 2 weights
// [pairs], 3 mid (bfloat: the down GEMM's operand). Params: 4 F, 5 limit.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_moe_swiglu
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    const uint F = arg_u32(4);
    const float limit = arg_f32(5);
    const uint j = gl_GlobalInvocationID.x;
    const uint p = gl_GlobalInvocationID.y;
    const uint64_t at = uint64_t(p) * F + j;
    float g = F32(arg(0) + 4u * at).v[0], u = F32(arg(1) + 4u * at).v[0];
    if (limit > 1e-6) {
        g = min(g, limit);
        u = clamp(u, -limit, limit);
    }
    // In this order (glm53_gemm_moe_gate_up_iq2_xxs computes the same).
    precise float gu = g * u;
    precise float e = exp2(-(g * uintBitsToFloat(0x3fb8aa3bu)));
    precise float sv = F32(arg(2)).v[p] * (gu * (1.0 / (1.0 + e)));
    BF16(arg(3) + 2u * at).v[0] = uintBitsToBFloat16EXT(uint16_t(glm53_bf16_bits(sv)));
}
#endif

// ---------------------------------------------------------------------------
// out[i][r] = sum over the row's slots of down[i * used + s][r], plus
// shared[i][r] (moe + shared, as ds4). out may be shared.
// Grid::Threads (H, rows). Buffers: 0 down [pairs][H], 1 shared, 2 out.
// Params: 3 H, 4 used.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_moe_combine
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    const uint H = arg_u32(3);
    const uint used = arg_u32(4);
    const uint r = gl_GlobalInvocationID.x;
    const uint i = gl_GlobalInvocationID.y;
    float acc = 0.0;
    for (uint s = 0u; s < used; s++) acc += F32(arg(0) + 4u * (uint64_t(i * used + s) * H)).v[r];
    const uint64_t at = uint64_t(i) * H + r;
    F32(arg(2) + 4u * at).v[0] = acc + F32(arg(1) + 4u * at).v[0];
}
#endif
