#version 460
// The kernels of src/kernels/metal/vision.metal: the vision tower's
// position-embedding blend, the 2-D rotary over the fused qkv rows, and full
// bidirectional attention over the patches of one image. The comments there
// say why each is as it is; this is the same arithmetic in the same order.
#include "common.glsl"

uvec2 vision_grid_coords(uint r, uint gw) {
    uint blocks_w = gw / 2;
    uint iw = r % 2;
    uint ih = (r / 2) % 2;
    uint bw = (r / 4) % blocks_w;
    uint bh = r / (4 * blocks_w);
    return uvec2(bh * 2 + ih, bw * 2 + iw);
}

#ifdef KERNEL_vision_patch_pos_bf16
void vision_pos_axis_taps(uint i, uint n, uint side, out uvec2 taps, out vec2 w) {
    float src = float(i) * float(side - 1) / float(max(n - 1u, 1u));
    float f = floor(src);
    int t0 = int(f);
    taps = uvec2(uint(clamp(t0, 0, int(side) - 1)), uint(clamp(t0 + 1, 0, int(side) - 1)));
    float d0 = abs(src - f);
    float d1 = abs(src - f - 1.0);
    w = vec2(max(1.0 - d0, 0.0), max(1.0 - d1, 0.0));
}

// Grid::Threads (H, N).
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    uint64_t x = arg(0), table = arg(1);
    uint H = arg_u32(2), gh = arg_u32(3), gw = arg_u32(4), side = arg_u32(5);
    uint c = thread_position_in_grid.x;
    uint r = thread_position_in_grid.y;
    if (c >= H) return;
    uvec2 rc = vision_grid_coords(r, gw);
    uvec2 ht, wt;
    vec2 hw, ww;
    vision_pos_axis_taps(rc.x, gh, side, ht, hw);
    vision_pos_axis_taps(rc.y, gw, side, wt, ww);
    precise float blend = 0.0;
    blend += hw.x * ww.x * float(BF16(table + 2 * uint64_t(ht.x * side + wt.x) * H).v[c]);
    blend += hw.x * ww.y * float(BF16(table + 2 * uint64_t(ht.x * side + wt.y) * H).v[c]);
    blend += hw.y * ww.x * float(BF16(table + 2 * uint64_t(ht.y * side + wt.x) * H).v[c]);
    blend += hw.y * ww.y * float(BF16(table + 2 * uint64_t(ht.y * side + wt.y) * H).v[c]);
    BF16 row = BF16(x + 2 * uint64_t(r) * H);
    row.v[c] = bfloat16_t(float(row.v[c]) + float(bfloat16_t(blend)));
}
#endif

#ifdef KERNEL_vision_qkv_rope_bf16
// Grid::Threads (H, N): one thread per rotate_half pair of q and of k.
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    uint H = arg_u32(1), D = arg_u32(2), gw = arg_u32(3);
    float theta = arg_f32(4);
    uint j = thread_position_in_grid.x;
    uint r = thread_position_in_grid.y;
    uint half_h = H / 2;
    if (j >= 2 * half_h) return;
    uint which = j / half_h;  // 0 q, 1 k
    uint within = j % half_h;
    uint half_d = D / 2;
    uint head = within / half_d;
    uint i = within % half_d;
    uint col0 = which * H + head * D + i;
    uint col1 = col0 + half_d;
    BF16 qkv = BF16(arg(0) + 2 * uint64_t(r) * 3 * H);
    float x0 = float(qkv.v[col0]);
    float x1 = float(qkv.v[col1]);
    uvec2 rc = vision_grid_coords(r, gw);
    uint quarter = half_d / 2;
    uint fi = i % quarter;
    float pos = float(i < quarter ? rc.x : rc.y);
    float inv_freq = 1.0 / pow(theta, float(2 * fi) / float(half_d));
    float ang = pos * inv_freq;
    float c = cos(ang);
    float s = sin(ang);
    qkv.v[col0] = bfloat16_t(x0 * c - x1 * s);
    qkv.v[col1] = bfloat16_t(x1 * c + x0 * s);
}
#endif

#ifdef KERNEL_vision_attn_nax_d72
// The tensor-op flash kernel: one 32-query tile and head per threadgroup of
// four subgroups, 64-key tiles, online softmax in f32. Metal's two matmul2d
// become 16x16x16 cooperative matrices (matmul.glsl):
//
// - QK^T: S [32, 64] in 2 x 4 blocks; subgroup s computes key columns
//   16 s.. for both query row blocks, walking D = 72 in five depth blocks
//   (the last 8 wide). Q's ten blocks stay in registers for the whole key
//   walk; blocks that cross D or the image's last row are staged with zeros
//   (Metal's tensor slices bounds-check them).
// - PV: O [32, 72] in 2 x 5 blocks over 64 keys. Subgroup s owns columns
//   16 s.. of both row blocks; the 8 columns past 64 come from a block over
//   columns 56..71 (inside the head, so no staging), which subgroups 0 and 1
//   compute for row block s and of which they keep columns 64.. only.
#include "matmul.glsl"

#define D 72
#define BQ 32
#define BK 64
#define SG 4
#define LANES ((32 * SG) / BQ)
#define DEPTH_BLOCKS ((D + 15) / 16)
#define TAIL_COL0 (D - 16)

shared float s_tile[BQ * BK];
shared bfloat16_t p_tile[BQ * BK];
shared float row_max[BQ], row_sum[BQ], row_alpha[BQ];
shared bfloat16_t mat_stage[MAT_STAGE_ELEMENTS(SG)];

void main() {
    uint64_t qkv = arg(0), out_addr = arg(1);
    uint N = arg_u32(2), H = arg_u32(3);
    float scale = arg_f32(4);
    uint tid = thread_index_in_threadgroup;
    uint s = gl_SubgroupID;
    if (threads_per_threadgroup.x != 32 * SG) return;
    int q0 = int(threadgroup_position_in_grid.x) * BQ;
    uint head = threadgroup_position_in_grid.y;
    int len = int(N);
    uint stride = 3 * H;

    if (tid < BQ) {
        row_max[tid] = -1.0 / 0.0;
        row_sum[tid] = 0.0;
    }
    barrier();

    uint64_t q_head = qkv + 2 * (uint64_t(q0) * stride + head * D);
    uint64_t k_head = qkv + 2 * uint64_t(H + head * D);
    uint64_t v_head = qkv + 2 * uint64_t(2 * H + head * D);

    MatA qa[2][DEPTH_BLOCKS];
    for (uint r = 0; r < 2; ++r) {
        uint rows = uint(clamp(len - q0 - int(16 * r), 0, 16));
        uint64_t q_rows = q_head + 2 * uint64_t(16 * r) * stride;
        for (uint d0 = 0; d0 < DEPTH_BLOCKS; ++d0) {
            uint depth = min(16u, D - 16 * d0);
            if (rows < 16 || depth < 16) {
                MAT_STAGE(q_rows + 2 * (16 * d0), stride, rows, depth)
                MAT_LOAD_STAGED_A(qa[r][d0]);
            } else {
                MAT_LOAD_A(qa[r][d0], BF16(q_rows).v, 16 * d0, stride);
            }
        }
    }

    MatC acc[3];
    for (uint i = 0; i < 3; ++i) acc[i] = MatC(0.0);
    // acc[0], acc[1]: columns 16 s.. of row blocks 0, 1; acc[2]: columns
    // TAIL_COL0.. of row block s (subgroups 0 and 1).
    bool has_tail = s < 2;

    uint row = tid / LANES;
    uint lane = tid % LANES;
    const uint cols = BK / LANES;
    uint j0 = lane * cols;

    for (int k0 = 0; k0 < len; k0 += BK) {
        // S = Q K^T, this subgroup's key columns.
        {
            int kb = k0 + int(16 * s);
            uint keys = uint(clamp(len - kb, 0, 16));
            MatC sacc[2];
            sacc[0] = MatC(0.0);
            sacc[1] = MatC(0.0);
            if (keys > 0) {
                uint64_t k_rows = k_head + 2 * uint64_t(kb) * stride;
                for (uint d0 = 0; d0 < DEPTH_BLOCKS; ++d0) {
                    uint depth = min(16u, D - 16 * d0);
                    MatB kb_m;
                    if (keys < 16 || depth < 16) {
                        MAT_STAGE(k_rows + 2 * (16 * d0), stride, keys, depth)
                        MAT_LOAD_STAGED_B(kb_m);
                    } else {
                        MAT_LOAD_B(kb_m, BF16(k_rows).v, 16 * d0, stride);
                    }
                    sacc[0] = coopMatMulAdd(qa[0][d0], kb_m, sacc[0]);
                    sacc[1] = coopMatMulAdd(qa[1][d0], kb_m, sacc[1]);
                }
            }
            for (uint r = 0; r < 2; ++r) {
                for (uint e = 0; e < 8; ++e) {
                    s_tile[(16 * r + mat_row(e)) * BK + 16 * s + mat_col(e)] = sacc[r][e];
                }
            }
        }
        barrier();

        // Every key of the image is visible: only the ragged last tile masks.
        int limit = min(len - k0, BK);
        float prev_max = row_max[row];
        float local_m = prev_max;
        for (uint j = j0; j < j0 + cols; ++j) {
            if (int(j) < limit) local_m = max(local_m, s_tile[row * BK + j] * scale);
        }
        for (uint off = 1u; off < LANES; off <<= 1) {
            local_m = max(local_m, subgroupShuffleXor(local_m, off));
        }
        float mx = local_m;
        float alpha = exp(prev_max - mx);
        float psum = 0.0;
        for (uint j = j0; j < j0 + cols; ++j) {
            float p = 0.0;
            if (int(j) < limit) p = exp(s_tile[row * BK + j] * scale - mx);
            p_tile[row * BK + j] = bfloat16_t(p);
            psum += p;
        }
        for (uint off = 1u; off < LANES; off <<= 1) {
            psum += subgroupShuffleXor(psum, off);
        }
        if (lane == 0u) {
            row_sum[row] = row_sum[row] * alpha + psum;
            row_max[row] = mx;
            row_alpha[row] = alpha;
        }
        barrier();

        for (uint e = 0; e < 8; ++e) {
            acc[0][e] *= row_alpha[mat_row(e)];
            acc[1][e] *= row_alpha[16 + mat_row(e)];
            if (has_tail) acc[2][e] *= row_alpha[16 * s + mat_row(e)];
        }
        // O += P V over the tile's keys.
        for (uint kk = 0; kk < BK / 16; ++kk) {
            int kb = k0 + int(16 * kk);
            uint keys = uint(clamp(len - kb, 0, 16));
            if (keys == 0) break;
            uint64_t v_rows = v_head + 2 * uint64_t(kb) * stride;
            MatA pa0, pa1;
            coopMatLoad(pa0, p_tile, 16 * kk, BK, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(pa1, p_tile, 16 * BK + 16 * kk, BK, gl_CooperativeMatrixLayoutRowMajor);
            // V's rows are the keys (B's rows here, not its columns).
            MatB vb;
            if (keys < 16) {
                MAT_STAGE(v_rows + 2 * (16 * s), stride, keys, 16)
                coopMatLoad(vb, mat_stage, gl_SubgroupID * 256, 16, gl_CooperativeMatrixLayoutRowMajor);
            } else {
                coopMatLoad(vb, BF16(v_rows).v, 16 * s, stride, gl_CooperativeMatrixLayoutRowMajor);
            }
            acc[0] = coopMatMulAdd(pa0, vb, acc[0]);
            acc[1] = coopMatMulAdd(pa1, vb, acc[1]);
            if (has_tail) {
                if (keys < 16) {
                    MAT_STAGE(v_rows + 2 * TAIL_COL0, stride, keys, 16)
                    coopMatLoad(vb, mat_stage, gl_SubgroupID * 256, 16, gl_CooperativeMatrixLayoutRowMajor);
                } else {
                    coopMatLoad(vb, BF16(v_rows).v, TAIL_COL0, stride, gl_CooperativeMatrixLayoutRowMajor);
                }
                if (s == 0) acc[2] = coopMatMulAdd(pa0, vb, acc[2]);
                else acc[2] = coopMatMulAdd(pa1, vb, acc[2]);
            }
        }
        // Finish with p_tile and s_tile before the next tile rewrites them.
        barrier();
    }

    for (uint b = 0; b < 3; ++b) {
        if (b == 2 && !has_tail) break;
        uint r0 = b == 2 ? 16 * s : 16 * b;
        uint c0 = b == 2 ? TAIL_COL0 : 16 * s;
        for (uint e = 0; e < 8; ++e) {
            uint r = r0 + mat_row(e), col = c0 + mat_col(e);
            // The tail block keeps the columns past the four full blocks.
            if (b == 2 && col < 64) continue;
            if (q0 + int(r) < len) {
                BF16 o = BF16(out_addr + 2 * (uint64_t(q0 + int(r)) * H + head * D));
                o.v[col] = bfloat16_t(acc[b][e] / row_sum[r]);
            }
        }
    }
}
#endif
